<section class="features-info-grid"
  {% if section.settings.bg_image %}
    style="background-image:url('{{ section.settings.bg_image | image_url: width: 2000 }}');"
  {% endif %}
>
  <div class="features-overlay"></div>

  <div class="page features-wrapper">
    <div class="features-grid">
      {% for block in section.blocks %}
        <div class="feature-item" {{ block.shopify_attributes }}>
          {% if block.settings.icon %}
            <div class="feature-icon">
              <img src="{{ block.settings.icon | image_url: width: 180 }}" alt="{{ block.settings.title | escape }}">
            </div>
          {% endif %}
          <div class="feature-content">
            <h3 class="feature-title">{{ block.settings.title }}</h3>
            <p class="feature-text">{{ block.settings.text }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
/* ------------------------------
   FEATURES SECTION
------------------------------ */

.features-info-grid {
  position: relative;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  padding: 5rem 2rem;
  color: #0f1f3d !important;
  overflow: hidden;
}

/* Subtle white overlay to lighten background image */
.features-overlay {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(
    rgba(255, 255, 255, 0.9),
    rgba(255, 255, 255, 0.95)
  );
  z-index: 1;
}

.features-wrapper {
  position: relative;
  z-index: 2;
  max-width: 1400px;
  margin: 0 auto;
}

/* ------------------------------
   GRID LAYOUT
------------------------------ */
.features-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 3rem 4rem;
  justify-items: center;
  align-items: start;
  text-align: left;
  padding: 4rem 5rem;

}

/* ------------------------------
   FEATURE ITEMS
------------------------------ */
.feature-item {
  display: flex;
  align-items: flex-start;
  gap: 1.25rem;
  max-width: 420px;
}
.feature-item p {
    font: 400 .95rem / 1.4 "Heebo", sans-serif;
    margin: 0;
}
/* ICON */
.feature-icon img {
  width: 110px;  /* matches screenshot scale */
  height: 110px;
  object-fit: contain;
  flex-shrink: 0;
  filter: drop-shadow(0 3px 6px rgba(0,0,0,0.08));
}

/* TITLE */
.feature-title {
  font-size: 1.2rem;
  font-weight: 800;
  text-transform: uppercase;
  color: #1c2b47 !important;
  margin: 0 0 0.4rem;
  font-family: "League Spartan", sans-serif;
}

/* TEXT */
.feature-text {
  font-family: "Heebo", sans-serif;
  font-size: 1rem;
  line-height: 1.6;
  font-weight: 500;
  color: #1c2b47 !important;
  margin: 0;
}

/* ------------------------------
   RESPONSIVE
------------------------------ */

/* Tablet (up to ~990px) */
@media (max-width: 989px) {
  .features-info-grid {
    padding: 3.5rem 1.5rem;
  }

  .features-grid {
    grid-template-columns: 1fr 1fr;
    gap: 2rem 1.5rem;
    padding: 2rem 1rem;
  }

  .feature-icon img {
    width: 85px;
    height: 85px;
  }

  .feature-title {
    font-size: 1.05rem;
  }

  .feature-text {
    font-size: 0.9rem;
  }
}

/* Mobile (up to ~749px) */
@media (max-width: 749px) {

  .features-info-grid {
    padding: 3rem 1.25rem;
  }

  .features-grid {
    grid-template-columns: 1fr;
    gap: 2rem;
    padding: 0;
    text-align: center;
  }

  .feature-item {
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 100%;
    padding: 0 0.5rem;
  }

  .feature-icon img {
    width: 80px;
    height: 80px;
  }

  .feature-title {
    font-size: 1.05rem;
    margin-top: 0.5rem;
  }

  .feature-text {
    width: 100%;
    max-width: 380px;
    margin: 0.5rem auto 0;
    font-size: 0.92rem;
    line-height: 1.55;
  }

  /* Lighten overlay so text does not look faded */
  .features-overlay {
    background: linear-gradient(
      rgba(255, 255, 255, 0.85),
      rgba(255, 255, 255, 0.9)
    );
  }
}

/* Small mobile (up to 480px) */
@media (max-width: 480px) {

  .features-info-grid {
    padding: 2.5rem 1rem;
  }

  .feature-icon img {
    width: 70px;
    height: 70px;
  }

  .feature-title {
    font-size: 1rem;
  }

  .feature-text {
    font-size: 0.88rem;
    max-width: 330px;
  }
}

{% endstylesheet %}


{% schema %}
{
  "name": "Features Info Grid",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (optional)",
      "info": "Upload a bright or textured background like waves."
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Feature Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Feature Title",
          "default": "Wakesurf Rated"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Feature Description",
          "default": "For wakesurfing with the Bimini Extension deployed, simply pass the rope underneath the shade."
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Features Info Grid",
      "blocks": [
        { "type": "feature", "settings": { "title": "Wakesurf Rated" } },
        { "type": "feature", "settings": { "title": "Fully Customizable" } },
        { "type": "feature", "settings": { "title": "60 Second Deployment" } },
        { "type": "feature", "settings": { "title": "Premium Carbon Fiber" } },
        { "type": "feature", "settings": { "title": "UV Performance Fabric" } }
      ]
    }
  ]
}
{% endschema %}
