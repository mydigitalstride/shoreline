<section class="gallery-filter-section">
  <div class="gallery-filter-page-width">
    {% if section.settings.heading != blank %}
      <h2 class="gallery-filter-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="gallery-filter-controls">
      <select id="galleryMakeSelect" class="gallery-filter-select">
        <option value="">Select Make</option>
      </select>

      <div class="gallery-filter-buttons">
        <button id="galleryClearBtn" class="gallery-clear-btn">CLEAR</button>
        <button id="gallerySearchBtn" class="gallery-search-btn">SEARCH</button>
      </div>
    </div>

    <p id="galleryFilterStatus" class="gallery-filter-status" style="display:none"></p>
  </div>
</section>

<script>
(function () {
  // Canonical make names mapped to accepted aliases (handles title typos/variations)
  var MAKE_ALIASES = {
    'ATX':         ['ATX'],
    'Axopar':      ['Axopar'],
    'Axis':        ['Axis'],
    'Barletta':    ['Barletta'],
    'Centurion':   ['Centurion'],
    'Chaparral':   ['Chaparral'],
    'Cobalt':      ['Cobalt'],
    'Heyday':      ['Heyday'],
    'Malibu':      ['Malibu'],
    'Mastercraft': ['Mastercraft', 'MasterCraft'],
    'MB':          ['MB'],
    'Moomba':      ['Moomba'],
    'Nautique':    ['Nautique', 'Nautiqe'],
    'Regal':       ['Regal'],
    'Sanger':      ['Sanger'],
    'Supreme':     ['Supreme'],
    'Supra':       ['Supra'],
    'Tige':        ['Tige', 'Tigue'],
    'Yamaha':      ['Yamaha']
  };

  // Flat list sorted longest-first so longer aliases match before shorter ones
  var MAKE_LIST = [];
  Object.keys(MAKE_ALIASES).forEach(function (canonical) {
    MAKE_ALIASES[canonical].forEach(function (alias) {
      MAKE_LIST.push({ alias: alias, canonical: canonical });
    });
  });
  MAKE_LIST.sort(function (a, b) { return b.alias.length - a.alias.length; });

  function escapeRegex(s) {
    return s.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&');
  }

  function parseMake(title) {
    if (!title) return '';
    title = title.trim();

    // Skip multi-boat entries (e.g. "Centurion FI23 and Malibu 25LSV")
    if (/ and /i.test(title)) return '';

    // Strip leading year or year-range to get to the make
    var rest = title.replace(/^\d{4}(?:\s*[-\u2013]\s*\d{4})?\s+/, '');

    // Try matching a make at the START of the remaining string
    for (var i = 0; i < MAKE_LIST.length; i++) {
      var entry = MAKE_LIST[i];
      var re = new RegExp('^' + escapeRegex(entry.alias) + '\\b', 'i');
      if (re.test(rest)) return entry.canonical;
    }

    // Fallback: make appears anywhere (e.g. "Super Air Nautique")
    for (var j = 0; j < MAKE_LIST.length; j++) {
      if (rest.toLowerCase().indexOf(MAKE_LIST[j].alias.toLowerCase()) !== -1) {
        return MAKE_LIST[j].canonical;
      }
    }

    return '';
  }

  // Returns the max columns for the current viewport, matching the grid CSS breakpoints
  function maxGridCols() {
    var w = window.innerWidth;
    if (w <= 989) return 2;
    if (w <= 1200) return 3;
    return 4;
  }

  // After show/hide changes, update each grid's column count so rows stay full
  function rebalanceGrids(isFiltered) {
    document.querySelectorAll('.boat-gallery-grid').forEach(function (grid) {
      var section = grid.closest('.boat-gallery-section');

      if (!isFiltered) {
        grid.style.gridTemplateColumns = '';
        if (section) section.style.display = '';
        return;
      }

      var cards = Array.from(grid.querySelectorAll('.boat-gallery-card'));
      var visible = cards.filter(function (c) { return c.style.display !== 'none'; }).length;

      if (visible === 0) {
        if (section) section.style.display = 'none';
      } else {
        if (section) section.style.display = '';
        var cols = Math.min(visible, maxGridCols());
        grid.style.gridTemplateColumns = 'repeat(' + cols + ', 1fr)';
      }
    });
  }

  document.addEventListener('DOMContentLoaded', function () {
    var makeSelect = document.getElementById('galleryMakeSelect');
    var searchBtn  = document.getElementById('gallerySearchBtn');
    var clearBtn   = document.getElementById('galleryClearBtn');
    var statusEl   = document.getElementById('galleryFilterStatus');

    // Gather every gallery card and extract its make from the title
    var allCards = Array.from(document.querySelectorAll('.boat-gallery-card'));
    var cardData = allCards.map(function (el) {
      return {
        element: el,
        make: parseMake(el.dataset.title || '')
      };
    });

    var filterableCards = cardData.filter(function (c) { return c.make; });

    // Populate make dropdown with unique sorted makes
    var makes = Array.from(new Set(filterableCards.map(function (c) { return c.make; }))).sort();
    makeSelect.innerHTML = '<option value="">Select Make</option>' +
      makes.map(function (m) { return '<option value="' + m + '">' + m + '</option>'; }).join('');

    searchBtn.addEventListener('click', function () {
      var make = makeSelect.value;

      if (!make) {
        cardData.forEach(function (c) { c.element.style.display = ''; });
        rebalanceGrids(false);
        statusEl.style.display = 'none';
        return;
      }

      var visibleCount = 0;
      cardData.forEach(function (c) {
        var show = c.make === make;
        c.element.style.display = show ? '' : 'none';
        if (show) visibleCount++;
      });

      rebalanceGrids(true);

      statusEl.style.display = 'block';
      statusEl.textContent = visibleCount > 0
        ? 'Showing ' + visibleCount + ' result' + (visibleCount !== 1 ? 's' : '')
        : 'No results found for your selection.';
    });

    clearBtn.addEventListener('click', function () {
      makeSelect.value = '';
      cardData.forEach(function (c) { c.element.style.display = ''; });
      rebalanceGrids(false);
      statusEl.style.display = 'none';
    });
  });
})();
</script>

{% stylesheet %}
.gallery-filter-section {
  background: #1c2b47;
  padding: 2rem 5rem;
  border-bottom: 2px solid rgba(255, 255, 255, 0.1);
}

.gallery-filter-page-width {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.gallery-filter-heading {
  font-family: "League Spartan", sans-serif;
  font-weight: 800;
  font-size: 1.6rem;
  color: #ffffff;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin: 0;
}

.gallery-filter-controls {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
}

.gallery-filter-select {
  padding: 0.85rem 1rem;
  border: 3px solid #ffffff;
  font-size: 1rem;
  font-weight: 700;
  background: #fff;
  color: #1c2b47;
  cursor: pointer;
  min-width: 200px;
  flex: 1;
  font-family: "Heebo", sans-serif;
}

.gallery-filter-buttons {
  display: flex;
  gap: 0.75rem;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}

.gallery-search-btn,
.gallery-clear-btn {
  padding: 0.85rem 1.75rem;
  font-weight: 800;
  text-transform: uppercase;
  color: #fff;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  font-family: "League Spartan", sans-serif;
  font-size: 1rem;
  white-space: nowrap;
  position: relative;
  z-index: 1;
  pointer-events: auto;
}

.gallery-search-btn {
  background: #f15a29;
}

.gallery-search-btn:hover {
  background: #d94e21;
}

.gallery-clear-btn {
  background: transparent;
  border: 2px solid rgba(255, 255, 255, 0.6);
}

.gallery-clear-btn:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: #fff;
}

.gallery-filter-status {
  color: rgba(255, 255, 255, 0.85);
  font-family: "Heebo", sans-serif;
  font-size: 0.95rem;
  margin: 0;
  font-style: italic;
}

@media (max-width: 989px) {
  .gallery-filter-section {
    padding: 1.5rem 2rem;
  }

  .gallery-filter-controls {
    flex-direction: column;
    align-items: stretch;
  }

  .gallery-filter-select {
    min-width: unset;
    width: 100%;
  }

  .gallery-filter-buttons {
    width: 100%;
  }

  .gallery-search-btn,
  .gallery-clear-btn {
    flex: 1;
  }
}

@media (max-width: 600px) {
  .gallery-filter-section {
    padding: 1.5rem 1.25rem;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Gallery Filter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Filter Heading",
      "default": "Filter Gallery by Boat"
    }
  ],
  "presets": [
    {
      "name": "Gallery Filter"
    }
  ]
}
{% endschema %}
