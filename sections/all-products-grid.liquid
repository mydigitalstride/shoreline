<section class="all-products-grid">
  <div class="page-width">

    <!-- === HEADER WITH FILTER BUTTON === -->
    <div class="products-header">
      {% if section.settings.heading != blank %}
        <h2 class="products-heading">{{ section.settings.heading }}</h2>
      {% endif %}

      <!-- === FILTER DROPDOWN === -->
      <div class="product-filter-dropdown">
        <button class="filter-toggle">Filter by Product Type</button>
        <ul class="filter-menu">
          <li data-filter="all" class="active">All Products</li>
          <li data-filter="apparel">Apparel</li>
          <li data-filter="best-sellers">Best Sellers</li>
          <li data-filter="shade-extension-kits">Shade Extension Kits</li>
          <li data-filter="wakesurf">Wakesurf</li>
        </ul>
      </div>
    </div>

    <!-- === PRODUCT GRID === -->
    <div class="products-grid">
      {% for product in section.settings.products %}
        {% assign product_tags = product.tags | join: ' ' | downcase %}
        <div class="product-card" data-tags="{{ product_tags }}" data-title="{{ product.title | downcase }}">
          <!-- PRODUCT TITLE -->
          <h3 class="product-title-top">
            <a href="{{ product.url }}">{{ product.title }}</a>
          </h3>

          <!-- PRODUCT IMAGE -->
          {% if product.featured_image %}
            <a href="{{ product.url }}" class="product-image">
              <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}">
            </a>
          {% endif %}

          <!-- PRODUCT DETAILS -->
          <div class="product-content">
            {% liquid
              # 1. Get the specific variant so we can access metafields
              assign current_variant = product.selected_or_first_available_variant
              assign regular_price = current_variant.price
              assign final_price = regular_price
              assign is_discounted = false

              # 2. Check for Distributor Tag + Metafield existence
              if customer and customer.tags contains 'distributor'
                assign dist_price = current_variant.metafields.custom.distributor_price.value
                if dist_price != blank
                  assign final_price = dist_price
                  assign is_discounted = true
                  # Use the true original price as the strikethrough, not the sale price
                  if current_variant.compare_at_price > current_variant.price
                    assign regular_price = current_variant.compare_at_price
                  endif
                endif
              endif
            %}

            <p class="product-price">
              {% if is_discounted %}
                <span style="text-decoration: line-through; opacity: 0.6; font-size: 0.9em; margin-right: 5px;">
                  {{ regular_price | money }}
                </span>
                <span style="color: #e76c3c;"> {{ final_price | money }}
                </span>
              {% else %}
                {{ regular_price | money }}
              {% endif %}
            </p>

            <div class="product-stars">
              {% for i in (1..5) %}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="#46b3b8">
                  <path d="M12 2l2.9 6.9L22 10l-5 4.9 1.2 7.1L12 18l-6.2 4 1.2-7.1L2 10l7.1-1.1L12 2z"/>
                </svg>
              {% endfor %}
            </div>

            <form method="post" action="/cart/add">
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              <button type="submit" class="add-to-cart-btn">Add to Cart</button>
            </form>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- === FILTER SCRIPT === -->
<script>
document.addEventListener('DOMContentLoaded', () => {
  const toggle = document.querySelector('.filter-toggle');
  const menu = document.querySelector('.filter-menu');
  const items = document.querySelectorAll('.filter-menu li');
  const cards = document.querySelectorAll('.product-card');

  // Toggle dropdown open/close
  toggle.addEventListener('click', () => {
    menu.classList.toggle('open');
  });

  // Handle filtering
  items.forEach(item => {
    item.addEventListener('click', () => {
      const filter = item.dataset.filter;

      items.forEach(i => i.classList.remove('active'));
      item.classList.add('active');
      toggle.textContent = item.textContent;
      menu.classList.remove('open');

      cards.forEach(card => {
        const tags = card.dataset.tags;
        const title = card.dataset.title;
        if (filter === 'all' || tags.includes(filter) || title.includes(filter)) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });

  // Close dropdown if clicked outside
  document.addEventListener('click', e => {
    if (!e.target.closest('.product-filter-dropdown')) {
      menu.classList.remove('open');
    }
  });
});
</script>

{% stylesheet %}
/* === SECTION CONTAINER === */
.all-products-grid {
  background: #ffffff;
  padding: 4rem 2rem;
  color: #0f1f3d;
}

/* === HEADER WITH HEADING + FILTER BUTTON === */
.products-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rem 5rem 1rem;
  flex-wrap: wrap;
  gap: 1rem;
}

.products-heading {
  font-size: clamp(1.8rem, 3vw, 2.8rem);
  font-weight: 800;
  color: #0f1f3d;
  margin: 0;
}

/* === FILTER DROPDOWN === */
.product-filter-dropdown {
  position: relative;
  display: inline-block;
  z-index: 10;
}

.filter-toggle {
  background: #e76c3c;
  color: #fff;
  font-weight: 700;
  text-transform: uppercase;
  font-family: "League Spartan", sans-serif;
  padding: 0.8rem 2rem;
  border: none;
  cursor: pointer;
  font-size: 1rem;
  transition: background 0.3s ease;
}

.filter-toggle:hover {
  background: #d45c2c;
}

.filter-menu {
  display: none;
  position: absolute;
  top: 100%;
  left: 0;
  background: #e76c3c;
  list-style: none;
  margin: 0;
  padding: 0;
  width: 100%;
  border-top: 2px solid #fff;
  box-shadow: 0 4px 10px rgba(0,0,0,0.15);
}

.filter-menu.open {
  display: block;
}

.filter-menu li {
  color: #fff;
  padding: 1rem;
  text-align: center;
  cursor: pointer;
  font-weight: 600;
  font-family: "Heebo", sans-serif;
  transition: background 0.2s ease;
}

.filter-menu li:hover,
.filter-menu li.active {
  background: #d45c2c;
}

/* === GRID === */
.products-grid {
  display: grid;
  padding: 4rem 5rem;
  grid-template-columns: repeat(4, 1fr);
  gap: 2rem;
  justify-items: center;
}

/* === PRODUCT CARD === */
.product-card {
  background: #fff;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  width: 100%;
  max-width: 260px;
  text-align: center;
  border: none;
}
.product-image {
  display: block;
  width: 100%;
  aspect-ratio: 1 / 1;
  overflow: hidden;       
  border-radius: 15px;    
}

.product-card img{
  border-radius:15px;
}

.product-title-top {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 1.5rem;
  font-weight: 500;
  text-transform: uppercase;
  color: #0f1f3d;
  margin-bottom: 0.5rem;
  line-height: 1.1;
}

.product-title-top a {
  color: inherit;
  text-decoration: none;
  transition: color 0.3s ease;
}

.product-title-top a:hover {
  color: #46b3b8;
}

/* PRODUCT IMAGE — 1:1 Ratio */
.product-image {
  display: block;
  width: 100%;
  aspect-ratio: 1 / 1;
  overflow: hidden;
}

.product-image img {
  width: 100%;
  height: auto;
  object-fit: cover;
}

/* PRODUCT CONTENT */
.product-content {
  padding: 0.75rem 0 0;
}

.product-price {
  font-size: 0.9rem;
  font-weight: 700;
  color: #0f1f3d;
  margin-bottom: 0.5rem;
}

/* STARS */
.product-stars {
  display: flex;
  justify-content: center;
  margin-bottom: 0.75rem;
}

/* ADD TO CART BUTTON */
.add-to-cart-btn {
  background: #f15a29;
  color: #fff;
  font-weight: 700;
  text-transform: uppercase;
  padding: 0.6rem 1rem;
  border: 2px solid #f15a29;
  cursor: pointer;
  width: 100%;
  font-size: 0.8rem;
  letter-spacing: 0.5px;
  transition: all 0.3s ease;
}

.add-to-cart-btn:hover {
  background: #fff;
  color: #46b3b8;
  border-color: #46b3b8;
}

/* === RESPONSIVE === */
/* === RESPONSIVE FIXES === */

/* ——— TABLET ——— */
@media (max-width: 900px) {

  .products-header {
    padding: 2rem 1.5rem 1rem;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .products-heading {
    text-align: center;
    width: 100%;
  }

  .product-filter-dropdown {
    margin-top: 0.5rem;
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .filter-toggle {
    width: 100%;
    max-width: 320px;
  }

  .filter-menu {
    width: 100%;
    max-width: 320px;
    left: 50%;
    transform: translateX(-50%);
  }

  .products-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    padding: 1rem 1rem;
  }
}

/* ——— MOBILE ——— */
@media (max-width: 600px) {

  .all-products-grid {
    padding: 2.5rem 1rem;
  }

  .all-products-grid .page-width {
    padding: 0;
  }

  .products-header {
    padding: 1rem 0;
    gap: 1.25rem;
  }

  .products-heading {
    text-align: center;
    font-size: 1.8rem;
    margin: 0;
  }

  /* Filter centered + full width */
  .product-filter-dropdown {
    width: 100%;
    justify-content: center;
  }

  .filter-toggle {
    width: 100%;
    font-size: 0.9rem;
    padding: 0.75rem 1rem;
  }

  .filter-menu {
    width: 100%;
    max-width: 280px;
    left: 50%;
    transform: translateX(-50%);
  }

  /* Grid becomes 1 column */
  .products-grid {
    grid-template-columns:  repeat(2, 1fr);
    padding: 0;
    gap: 1.75rem;
  }

  /* Better product card scaling */
  .product-card {
    max-width: 100%;
    width: 100%;
    margin: 0 auto;
  }

  .product-title-top {
    font-size: 1.5rem;
  }

  .product-image {
    aspect-ratio: 1;
    height: auto;
    max-width: 95vw;
  }

  .product-content {
    padding-top: 0.5rem;
  }

  .product-price {
    font-size: 1.25rem;
  }

  .add-to-cart-btn {
    font-size: 0.85rem;
    padding: 0.65rem 1rem;
  }
}

/* ——— SMALL PHONES ——— */
@media (max-width: 400px) {

  .filter-toggle {
    max-width: 240px;
  }

  .filter-menu {
    max-width: 240px;
  }

  .product-title-top {
    font-size: 1.5rem;
  }

  .add-to-cart-btn {
    font-size: 0.8rem;
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "All Products Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "All Products"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Select Products to Display"
    }
  ],
  "presets": [
    {
      "name": "All Products Grid with Filter beside Heading"
    }
  ]
}
{% endschema %}
