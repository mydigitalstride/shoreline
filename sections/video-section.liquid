<section 
  class="video-section" 
  style="
    {% if section.settings.bg_image != blank %}
      background-image: url('{{ section.settings.bg_image | image_url: width: 2000 }}');
    {% endif %}
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center;
  "
>
  <div class="page-width">
    
    {% if section.settings.heading != blank %}
      <div class="heading-wrapper">
        <h1 class="video-title">
          {{ section.settings.heading }}
          <span class="teal-line"></span>
        </h1>
      </div>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="video-subtitle">{{ section.settings.subheading }}</p>
    {% endif %}

    <div class="video-wrapper">

      {%- comment -%}
      =============== VIDEO UPLOAD HAS PRIORITY ===============
      If user uploads a video file, we ignore YouTube URL.
      {%- endcomment -%}

      {% if section.settings.video_upload != blank %}
        <video 
          controls 
          preload="metadata"
          playsinline
          style="width:100%; height:100%; border-radius:8px;"
        >
          <source src="{{ section.settings.video_upload | video_url }}" type="video/mp4">
          Your browser does not support the video tag.
        </video>

      {% elsif section.settings.video_url != blank %}
        {% assign youtube_id = section.settings.video_url
          | replace: 'https://www.youtube.com/watch?v=', ''
          | replace: 'https://youtu.be/', ''
          | split: '&'
          | first
        %}
        <iframe
          src="https://www.youtube.com/embed/{{ youtube_id }}"
          title="YouTube video player"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      {% endif %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Video Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "UNIVERSAL WAKE TOWER INSTALLATION"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Watch this short video below for installation of our Universal Wake Tower Bimini Extension"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "YouTube Video URL",
      "default": "https://www.youtube.com/watch?v=abcdefg",
      "info": "Paste any YouTube link. Ignored if a video file is uploaded."
    },
    {
      "type": "video",
      "id": "video_upload",
      "label": "Upload Video File",
      "info": "Upload an MP4/MOV video. This will override the YouTube URL."
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    }
  ],
  "presets": [
    {
      "name": "Video Section"
    }
  ]
}
{% endschema %}

<style>
@import url('https://fonts.googleapis.com/css2?family=League+Spartan:wght@600;700;800&display=swap');

.video-section {
  padding: 80px 20px;
  color: #1a1a1a;
}

.heading-wrapper {
  text-align: left;
  margin-bottom: 10px;
  max-width: 900px;
  margin-left: auto;
  margin-right: auto;
}

.video-title {
  font-family: "League Spartan", sans-serif;
  font-size: 2.8rem;
  font-weight: 800;
  text-transform: uppercase;
  color: #2c3c5e;
  position: relative;
  display: inline-block;
  padding-bottom: 14px;
  margin-bottom: 30px;
  letter-spacing: 0.5px;
}

.video-title .teal-line {
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  width: 260px;
  height: 5px;
  background: linear-gradient(to right, #0097a7, rgba(0, 151, 167, 0));
  border-radius: 3px;
  opacity: 0.95;
}

.video-subtitle {
  font-size: 1.1rem;
  text-align: left;
  max-width: 900px;
  margin: 0 auto 40px;
  color: #1a1a1a;
  line-height: 1.5;
}

.video-wrapper {
  position: relative;
  max-width: 900px;
  margin: 0 auto;
  overflow: hidden;
  border-radius: 8px;
  box-shadow: 0 8px 20px rgba(0,0,0,0.2);
}

.video-wrapper iframe,
.video-wrapper video {
  width: 100%;
  height: 500px;
  display: block;
  border-radius: 8px;
}

@media (max-width: 768px) {
  .video-title {
    font-size: 2rem;
  }
  .video-wrapper iframe,
  .video-wrapper video {
    height: 320px;
  }
}
</style>
