<section
  class="faq-section"
  {% if section.settings.bg_image != blank %}
    style="background-image: url('{{ section.settings.bg_image | image_url: width: 1600 }}');"
  {% endif %}
>
  <div class="page-wrapper">
    <div class="faq-wrapper">
      <!-- Left Column -->
      <div class="faq-left">
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.subtext }}</p>
        <a href="{{ section.settings.button_link }}" class="faq-btn">
          {{ section.settings.button_text }}
        </a>
      </div>

      <!-- Right Column -->
      <div class="faq-right">
        {% for block in section.blocks %}
          <details class="faq-item" {{ block.shopify_attributes }}>
            <summary class="faq-question">{{ block.settings.question }}</summary>
            <div class="faq-answer">
              {{ block.settings.answer }}
            </div>
          </details>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
/* ------------------------------
   FAQ SECTION
------------------------------ */
.page-wrapper{
  padding: 4rem 3rem;
}
.faq-section {
  position: relative;
  padding: 4rem 2rem;
  color: #fff;
  background-color: #2c3c5e !important;
  background-position: center;
  background-size: cover;
  background-repeat: no-repeat;
}

.faq-wrapper {
  background-color: #2c3c5e;
  padding: 4rem 2rem;
  display: grid;
  grid-template-columns: 1fr 2fr;
  align-items: start;
  gap: 3rem;
}

/* LEFT SIDE */
.faq-left h2 {
  font-size: 2.4rem;
  font-family: "League Spartan", sans-serif;
  margin-bottom: 1rem;
}

.faq-left p {
  margin-bottom: 2.5rem;
  font-family: "Heebo", sans-serif;
  font-size: 1.1rem;
  line-height: 1.7;
  max-width: 550px;
  color: rgba(255, 255, 255, 0.9);
}

.faq-btn {
  display: inline-block;
  padding: 0.75rem 1.5rem;
  border: 2px solid #fff;
  color: #fff;
  font-weight: bold;
  text-decoration: none;
  font-family: "Heebo", sans-serif;
  transition: all 0.2s ease;
}

.faq-btn:hover {
  background: #fff;
  color: #2c3c5e;
}

/* RIGHT SIDE */
.faq-right {
  font-family: "Heebo", sans-serif;
}

.faq-item {
  margin-bottom: 1rem;
  border: none;
  background: transparent;
}

.faq-question {
  padding: 1rem 1.25rem;
  background: #fff;
  color: #2c3c5e;
  font-weight: 700;
  font-family: "Heebo", sans-serif;
  font-size: 1.1rem;
  cursor: pointer;
  list-style: none;
  transition: background 0.2s ease;
}

.faq-question:hover {
  background: #b4f3f5;
}

.faq-answer {
  padding: 1.25rem 1.25rem 1.5rem;
  color: #fff;
  font-size: 1rem;
  font-family: "Heebo", sans-serif;
  line-height: 1.6;
}

.faq-item[open] .faq-question {
  background: #b4f3f5;
  color: #1f2d50;
}

/* --- RESPONSIVE --- */
@media screen and (max-width: 1024px) {
  .faq-wrapper {
    grid-template-columns: 1fr;
    gap: 3rem;
    padding: 3rem 1.5rem;
  }
}

/* --- MOBILE --- */
@media screen and (max-width: 749px) {
  .faq-section {
    padding: 3rem 1rem;
  }

  .faq-wrapper {
    grid-template-columns: 1fr;
    text-align: center;
    gap: 2.5rem;
  }

  .faq-left {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    margin-top: 1rem;
  }

  .faq-left h2 {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .faq-left p {
    margin-bottom: 2rem;
    font-size: 1rem;
    max-width: 100%;
    padding: 0 1rem;
    color: rgba(255, 255, 255, 0.9);
  }

  .faq-btn {
    padding: 0.8rem 2rem;
    font-size: 0.95rem;
  }

  .faq-right {
    text-align: left;
  }

  .faq-question {
    font-size: 1rem;
    padding: 1rem;
  }

  .faq-answer {
    padding: 1rem;
    font-size: 0.95rem;
    line-height: 1.6;
  }
}

/* --- EXTRA SMALL --- */
@media screen and (max-width: 480px) {
  .faq-left h2 {
    font-size: 1.7rem;
  }

  .faq-left p {
    font-size: 0.95rem;
  }

  .faq-btn {
    width: 100%;
    max-width: 250px;
    text-align: center;
  }

  .faq-question {
    font-size: 0.95rem;
  }
}
{% endstylesheet %}


{% schema %}
{
  "name": "FAQ Two Column",
  "settings": [
    { "type": "image_picker", "id": "bg_image", "label": "Background Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Add supporting text here." },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Contact Us" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Sample question" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "Sample answer text." }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    { "name": "FAQ Two Column" }
  ]
}
{% endschema %}
