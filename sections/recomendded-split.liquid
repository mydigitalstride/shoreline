  color:(var--color-surface);
  letter-spacing: 1px;

} */
/* ------------------------------
   RESPONSIVE STYLES
------------------------------ */
.product-card{
  background: transparent !important;
}
/* Tablet */
@media (max-width: 989px) {
  .best-sellers-wrapper {
    grid-template-columns: 1fr;
  }

  .left-inner{
    margin:0px;
  }
  .best-sellers-left {
    padding: 3rem 2rem;
    justify-content: center;
    text-align: center;
  }

  .bestsellers-heading {
    margin-bottom: 2rem;
    font-size: 3rem;
    text-align: center;
  }

  .best-sellers-grid {
    grid-template-columns: repeat(2, 1fr);
    justify-items: center;
  }

  .product-card {
    transform: none;
    text-align: center;
t;
  }

  .best-sellers-right {
    clip-path: none;
    padding: 4rem 2rem;
  }

  .story-heading {
    font-size: 2rem;
  }
}

/* Mobile */
@media (max-width: 749px) {
  .best-sellers-left {
    padding: 2.5rem 1.25rem;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .bestsellers-heading {

    margin-bottom: 1.5rem;
  }

  .best-sellers-grid {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .product-card {
    padding: 1rem 0.5rem;
    text-align: center;
  }

  .product-title {
    font-size: 1rem;
  }

  .add-to-cart {
    width: 100%;
    max-width: none;
    font-size: 0.9rem;
    margin: 0 auto;
  }

  .best-sellers-right {
    clip-path: none;
    padding: 3rem 1.5rem;
    background-position: center;
  }

  .story-logo {
    max-width: 150px;
    margin-bottom: 1rem;
  }

  .story-heading {
    font-size: 1.6rem;
  }

  .story-btn {
    margin-top: 1.2rem;
    font-size: 0.95rem;
    padding: 0.75rem 1.25rem;
    width: 80%;
    max-width: 240px;
  }
}

/* Extra Small (Phones) */
@media (max-width: 480px) {
  .best-sellers-grid {
    gap: 1.2rem;
  }

  .product-title {
    font-size: 1rem;
  }

  .story-heading {
    font-size: 1.4rem;
  }

  .story-btn {
    width: 100%;
    max-width: 220px;
    padding: 0.8rem 1.2rem;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Best Sellers with Story",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best Sellers" },
    { "type": "product_list", "id": "products", "label": "Select Products" },
    { "type": "image_picker", "id": "bg_image_left", "label": "Left Background Image" },
    { "type": "image_picker", "id": "bg_image_right", "label": "Right Background Image" },
    { "type": "image_picker", "id": "logo", "label": "Right Logo" },
    { "type": "text", "id": "story_heading", "label": "Right Heading", "default": "The Shoreline Story" },
    { "type": "text", "id": "button_text", "label": "Right Button Text", "default": "About Shoreline" },
    { "type": "url", "id": "button_link", "label": "Right Button Link" }
  ],
  "presets": [
    { "name": "Best Sellers with Story" }
  ]
}
{% endschema %}
