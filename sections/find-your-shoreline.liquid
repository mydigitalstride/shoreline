<section class="find-your-shoreline">
  <div class="page-width">
    <h2 class="find-heading">{{ section.settings.heading }}</h2>

    <div class="finder-layout">
      <!-- LEFT FILTER FORM -->
      <div class="finder-filters">
        <select id="yearSelect" class="finder-select">
          <option value="">Select Year</option>
        </select>

        <select id="makeSelect" class="finder-select">
          <option value="">Select Make</option>
        </select>

        <select id="modelSelect" class="finder-select" disabled>
          <option value="">Select Model</option>
        </select>

        <div class="finder-buttons">
          <button id="clearBtn" class="clear-btn">Clear</button>
          <button id="searchBtn" class="search-btn">Search</button>
        </div>
      </div>

      <!-- RIGHT SIDE: RESULTS -->
      <div class="finder-results" id="resultsContainer"></div>
    </div>
  </div>
</section>

<script>
document.addEventListener("DOMContentLoaded", function() {
  const yearSelect = document.getElementById("yearSelect");
  const makeSelect = document.getElementById("makeSelect");
  const modelSelect = document.getElementById("modelSelect");
  const searchBtn = document.getElementById("searchBtn");
  const clearBtn = document.getElementById("clearBtn");
  const resultsContainer = document.getElementById("resultsContainer");

  let data = [];

  // Load boats.json
  fetch('{{ "boats.json" | asset_url }}')
    .then(res => res.json())
    .then(json => {
      data = json;
      console.log("Loaded boat data:", data);

      // Unique Years and Makes
      const years = [...new Set(data.map(item => String(item.Year)))].sort();
      const makes = [...new Set(data.map(item => item.Make))].sort();

      populateSelect(yearSelect, years);
      populateSelect(makeSelect, makes);
    })
    .catch(err => console.error("Error loading boats.json:", err));

  function populateSelect(select, values) {
    select.innerHTML += values.map(v => `<option value="${v}">${v}</option>`).join("");
  }

  // When Year or Make changes → update Models
  function updateModels() {
    const selectedYear = yearSelect.value;
    const selectedMake = makeSelect.value;

    if (!selectedYear && !selectedMake) {
      modelSelect.innerHTML = `<option value="">Select Model</option>`;
      modelSelect.disabled = true;
      return;
    }

    const filteredModels = data
      .filter(item =>
        (!selectedYear || String(item.Year) === selectedYear) &&
        (!selectedMake || item.Make?.toLowerCase() === selectedMake.toLowerCase())
      )
      .map(item => item.Model);

    const uniqueModels = [...new Set(filteredModels)].sort();

    modelSelect.innerHTML = `<option value="">Select Model</option>`;
    modelSelect.innerHTML += uniqueModels.map(m => `<option value="${m}">${m}</option>`).join("");
    modelSelect.disabled = uniqueModels.length === 0;
  }

  yearSelect.addEventListener("change", updateModels);
  makeSelect.addEventListener("change", updateModels);

  // SEARCH
  searchBtn.addEventListener("click", function() {
    const year = yearSelect.value;
    const make = makeSelect.value;
    const model = modelSelect.value;

    const filtered = data.filter(item =>
      (!year || String(item.Year) === year) &&
      (!make || item.Make?.toLowerCase() === make.toLowerCase()) &&
      (!model || item.Model?.toLowerCase() === model.toLowerCase())
    );

    displayResults(filtered);
  });

  // CLEAR
  clearBtn.addEventListener("click", function() {
    yearSelect.value = "";
    makeSelect.value = "";
    modelSelect.value = "";
    modelSelect.disabled = true;
    resultsContainer.innerHTML = "";
  });

  // DISPLAY RESULTS
  function displayResults(results) {
    if (!results.length) {
      resultsContainer.innerHTML = `<p class="no-results">No results found.</p>`;
      return;
    }

    resultsContainer.innerHTML = results.map(item => `
      <div class="result-card">
        <div class="result-info">
          <span>${item.Year || ""}</span>
          <span>${item.Make || ""}</span>
          <span>${item.Model || ""}</span>
        </div>
        <a href="${item.link && item.link.startsWith('http') ? item.link : '#'}"
           class="view-btn" target="_blank" rel="noopener">View Details</a>
      </div>
    `).join("");
  }
});
</script>

{% schema %}
{
  "name": "Find Shoreline Shade",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Find Your Shoreline Shade Bimini Extension"
    }
  ],
  "presets": [
    { "name": "Find Shoreline Shade" }
  ]
}
{% endschema %}


{% stylesheet %}
/* ------------------------------
   BASE STYLING
------------------------------ */
.find-your-shoreline {
  background: #f8f9fb;
  padding: 4rem 2rem;
  color: #1c2b47;
}

.find-heading {
  text-align: center;
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  font-weight: 800;
  color: #1c2b47;
  margin-bottom: 3rem;
  font-family: "League Spartan", sans-serif;
}

/* Layout */
.finder-layout {
  display: grid;
  padding: 4rem 5rem;
  grid-template-columns: 1fr 2fr;
  gap: 3rem;
  align-items: start;
}

/* LEFT FILTER FORM */
.finder-filters {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.finder-select {
  padding: 1rem;
  border: 3px solid #1c2b47;
  font-size: 1rem;
  font-weight: 700;
  background: #fff;
  color: #1c2b47;
  text-align: center;
  cursor: pointer;
  font-family: "Heebo", sans-serif;
}

.finder-buttons {
  display: flex;
  gap: 1rem;
  margin-top: 1rem;
}

.search-btn,
.clear-btn {
  flex: 1;
  padding: 0.75rem;
  font-weight: 800;
  text-transform: uppercase;
  color: #fff;
  border: none;
  cursor: pointer;
  font-family: "League Spartan", sans-serif;
}

.search-btn {
  background: #f15a29;
  transition: all 0.25s ease;
}

.search-btn:hover {
  background: #d94e21;
}

.clear-btn {
  background: #1c2b47;
  transition: all 0.25s ease;
}

.clear-btn:hover {
  background: #15223d;
}

/* RIGHT RESULTS */
.finder-results {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.result-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(90deg, #c3edf0 0%, #e0e3e5 100%);
  padding: 1rem 1.5rem;
  border-radius: 4px;
  flex-wrap: wrap;
}

.result-info {
  display: flex;
  flex-wrap: wrap;
  gap: 1.5rem;
  font-weight: 700;
  color: #1c2b47;
  font-family: "Heebo", sans-serif;
}

.view-btn {
  background: #1c2b47;
  color: #fff;
  padding: 0.75rem 1.5rem;
  text-decoration: none;
  font-weight: 700;
  border-radius: 3px;
  transition: all 0.25s ease;
  font-family: "League Spartan", sans-serif;
}

.view-btn:hover {
  background: #15223d;
}

.no-results {
  text-align: center;
  color: #1c2b47;
  font-weight: 700;
  margin-top: 1rem;
}

/* ------------------------------
   RESPONSIVE
------------------------------ */

/* --- Tablet --- */
@media (max-width: 1024px) {
  .finder-layout {
    grid-template-columns: 1fr;
    padding: 3rem 2rem;
    gap: 2rem;
  }

  .finder-filters {
    max-width: 500px;
    margin: 0 auto;
  }

  .finder-results {
    max-width: 600px;
    margin: 0 auto;
  }
}

/* --- Mobile --- */
@media (max-width: 749px) {
  .find-your-shoreline {
    padding: 3rem 1rem;
  }

  .find-heading {
    font-size: 2rem;
    margin-bottom: 2rem;
  }

  .finder-layout {
    grid-template-columns: 1fr;
    padding: 2rem 1rem;
    gap: 2rem;
  }

  .finder-filters {
    gap: 1rem;
    width: 100%;
  }

  .finder-select {
    padding: 0.9rem;
    font-size: 0.95rem;
  }

  .finder-buttons {
    flex-direction: column;
    gap: 0.75rem;
  }

  .search-btn,
  .clear-btn {
    width: 100%;
    font-size: 0.95rem;
    padding: 0.9rem;
    border-radius: 4px;
  }

  .finder-results {
    width: 100%;
    gap: 1rem;
  }

  .result-card {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1rem;
  }

  .result-info {
    gap: 0.75rem;
    font-size: 0.95rem;
  }

  .view-btn {
    width: 100%;
    text-align: center;
    padding: 0.8rem;
    font-size: 0.95rem;
  }
}

/* --- Extra Small Phones --- */
@media (max-width: 480px) {
  .find-heading {
    font-size: 1.7rem;
  }

  .finder-select {
    font-size: 0.9rem;
  }

  .search-btn,
  .clear-btn {
    font-size: 0.9rem;
    padding: 0.8rem;
  }

  .result-card {
    padding: 0.9rem;
  }

  .view-btn {
    font-size: 0.9rem;
  }
}
{% endstylesheet %}

