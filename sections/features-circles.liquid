<section class="circle-features-section"
  {% if section.settings.bg_image %}
    style="background-image:url('{{ section.settings.bg_image | image_url: width: 2000 }}');"
  {% endif %}
>
  <div class="circle-overlay"></div>

  <div class="page-width circle-features-wrapper">

    {% if section.settings.heading != blank %}
      <h2 class="circle-main-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="circle-features-grid">
      {% for block in section.blocks %}
        <div class="circle-feature-item">
          
          <div class="circle-feature-image">
            <img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.title }}">
          </div>

          <h3 class="circle-feature-title">{{ block.settings.title }}</h3>
          <p class="circle-feature-text">{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>

  </div>
</section>

{% stylesheet %}
/* ------------------------------
   SECTION BASE
------------------------------ */
.circle-features-section {
  position: relative;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  padding: 5rem 2rem;
  text-align: center;
  overflow: hidden;
}

.circle-overlay {
  content: "";
  position: absolute;
  inset: 0;
  background: rgba(255,255,255,0.8);
  backdrop-filter: blur(2px);
  z-index: 1;
}

.circle-features-wrapper {
  position: relative;
  z-index: 2;
}

/* Main Heading */
.circle-main-heading {
  font-size: clamp(2rem, 4vw, 2.8rem);
  font-weight: 800;
  color: #1c2b47;
  margin-bottom: 3rem;
}

/* ------------------------------
   GRID
------------------------------ */
.circle-features-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 3rem;
}

@media (max-width: 1100px) {
  .circle-features-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}
@media (max-width: 749px) {
  .circle-features-grid {
    grid-template-columns: repeat(1, 1fr);
  }
}

/* ------------------------------
   INDIVIDUAL FEATURE
------------------------------ */
.circle-feature-item {
  max-width: 340px;
  margin: 0 auto;
}

.circle-feature-image {
  width: 180px;
  height: 180px;
  border-radius: 50%;
  overflow: hidden;
  margin: 0 auto 1.5rem;
  box-shadow: 0 6px 14px rgba(0,0,0,0.15);
}

.circle-feature-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.circle-feature-title {
  font-size: 1.4rem;
  font-weight: 700;
  color: #1c2b47;
  margin-bottom: 0.5rem;
  font-family: "Georgia", serif;
}

.circle-feature-text {
  font-size: 1rem;
  line-height: 1.6;
  color: #2c3c5e;
  font-family: "Heebo", sans-serif;
}
{% endstylesheet %}

{% schema %}
{
  "name": "Circle Feature Row",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Our Features"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Circle Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Premium Carbon Fiber"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Your feature description goes here."
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Circle Feature Row",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}
