<section class="picture-hero"
  {% if section.settings.background_pattern %}
    style="background-image: url('{{ section.settings.background_pattern | image_url: width: 2000 }}');"
  {% endif %}
>
  <div class="picture-hero__wrapper">

    <!-- LEFT COLUMN: Menu / Thumbnails -->
    <div class="picture-hero__left">
      {% if section.settings.menu != blank %}
        <nav class="picture-hero__menu">
          <ul>
            {% for link in linklists[section.settings.menu].links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          </ul>
        </nav>
      {% endif %}

      <div class="picture-hero__thumbnails">
        {% for block in section.blocks %}
          {% if block.type == 'thumbnail' %}
            <img src="{{ block.settings.thumb | image_url: width: 400 }}" alt="{{ block.settings.alt_text }}" class="picture-hero__thumb">
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <!-- RIGHT COLUMN: Main Content -->
    <div class="picture-hero__right">
      {% if section.settings.main_image %}
        <img src="{{ section.settings.main_image | image_url: width: 1200 }}" alt="{{ section.settings.heading }}" class="picture-hero__main-img">
      {% endif %}

      <div class="picture-hero__content">
        <h2 class="picture-hero__title">{{ section.settings.heading }}</h2>

        {% if section.settings.price != blank %}
          <div class="picture-hero__price">{{ section.settings.price }}</div>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="picture-hero__desc">{{ section.settings.description }}</div>
        {% endif %}

        {% if section.settings.button_label != blank %}
          <a href="{{ section.settings.button_link }}" class="picture-hero__btn">{{ section.settings.button_label }}</a>
        {% endif %}
      </div>
    </div>

  </div>
</section>

{% stylesheet %}
/* === BASE SECTION === */
.picture-hero {
  background-color: #f8f8f8;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  padding: 2rem 0;
  position: relative;
}

/* WRAPPER */
.picture-hero__wrapper {
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: 2rem;
  align-items: start;
  max-width: 1400px;
  margin: 0 auto;
  padding: 2rem;
}

/* LEFT SIDE */
.picture-hero__left {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.5rem;
}

.picture-hero__menu ul {
  list-style: none;
  padding: 0;
  margin-bottom: 2rem;
}

.picture-hero__menu li {
  margin: 0.5rem 0;
}

.picture-hero__menu a {
  color: #1c2b47;
  text-decoration: none;
  font-weight: 700;
  transition: color 0.3s ease;
}

.picture-hero__menu a:hover {
  color: #e76c3c;
}

.picture-hero__thumbnails {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.picture-hero__thumb {
  width: 100%;
  max-width: 180px;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.picture-hero__thumb:hover {
  transform: scale(1.05);
}

/* RIGHT SIDE */
.picture-hero__right {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 1.5rem;
}

.picture-hero__main-img {
  width: 100%;
  height: auto;
  object-fit: cover;
  margin-bottom: 1rem;
}

.picture-hero__title {
  font-size: 2rem;
  font-weight: 800;
  color: #1c2b47;
  margin-bottom: 0.5rem;
}

.picture-hero__price {
  font-size: 1.5rem;
  font-weight: 700;
  color: #e76c3c;
  margin-bottom: 0.5rem;
}

.picture-hero__desc {
  color: #333;
  line-height: 1.5;
  margin-bottom: 1rem;
}

.picture-hero__btn {
  background: #e76c3c;
  color: #fff;
  font-weight: 700;
  text-transform: uppercase;
  padding: 0.9rem 2.2rem;
  text-decoration: none;
  transition: background 0.3s ease;
}

.picture-hero__btn:hover {
  background: #d45c2c;
}

/* RESPONSIVE */
@media (max-width: 900px) {
  .picture-hero__wrapper {
    grid-template-columns: 1fr;
  }

  .picture-hero__left {
    flex-direction: row;
    justify-content: center;
    flex-wrap: wrap;
  }

  .picture-hero__menu {
    display: none;
  }

  .picture-hero__thumb {
    max-width: 120px;
  }

  .picture-hero__title {
    text-align: center;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Picture Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_pattern",
      "label": "Background Pattern"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "2015 - 2025 Malibu Boats Bimini Mounted Shade Extension"
    },
    
    {
      "type": "text",
      "id": "price",
      "label": "Price",
      "default": "$700.00"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Wakesurf Shade Sail / Bimini Extension for all Malibu boats manufactured from 2015 to 2025. This kit mounts directly to your bimini frame and can be deployed while surfing up to 15mph.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Add to Cart"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "thumbnail",
      "name": "Thumbnail Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "thumb",
          "label": "Thumbnail Image"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Picture Hero - Product Style",
      "blocks": [
        { "type": "thumbnail" },
        { "type": "thumbnail" },
        { "type": "thumbnail" },
        { "type": "thumbnail" }
      ]
    }
  ]
}
{% endschema %}
