<section class="cta-crafted-usa"
  {% if section.settings.bg_image %}
    style="background-image:url('{{ section.settings.bg_image | image_url: width: 2000 }}');"
  {% endif %}
>
  <div class="page-width">
    <div class="cta-overlay"></div>

    <div class="cta-wrapper">
      <!-- LEFT COLUMN -->
      <div class="cta-col cta-left">
        <h2 class="cta-heading">{{ section.settings.left_heading }}</h2>
        <p class="cta-text">{{ section.settings.left_text }}</p>

        {% if section.settings.left_logo %}
          <div class="cta-logo">
            <img src="{{ section.settings.left_logo | image_url: width: 200 }}" alt="{{ section.settings.left_heading | escape }}">
          </div>
        {% endif %}
      </div>

      <!-- RIGHT COLUMN -->
      <div class="cta-col cta-right">
        <h2 class="cta-heading">{{ section.settings.right_heading }}</h2>
        <p class="cta-text">{{ section.settings.right_text }}</p>

        {% if section.settings.button_text != blank %}
          <a href="{{ section.settings.button_link }}" class="cta-btn">
            {{ section.settings.button_text }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
.cta-crafted-usa {
  position: relative;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  padding: 3rem 0;
  color: #1c2b47 !important;
  overflow: hidden;
}

/* ✅ Soft white overlay */
.cta-crafted-usa::before,
.cta-overlay {
  content: "";
  position: absolute;
  inset: 0;
  background: rgb(255 255 255 / 49%);
  z-index: 1;
}

/* ✅ Content above overlay */
.cta-wrapper {
  position: relative;
  z-index: 2;
  display: grid;
  padding: 4rem 5rem;
  grid-template-columns: repeat(2, 1fr);
  gap: 60px;
  align-items: start;
  justify-content: center;
  color: #1c2b47 !important;
}

/* Columns */
.cta-col {
  text-align: left;
}

.cta-heading {
  font-size: clamp(1.8rem, 3vw, 2.5rem);
  font-weight: 800;
  color: #1c2b47;
  margin-bottom: 1rem;
}

.cta-text {
  font-size: 1.05rem;
  line-height: 1.7;
  margin-bottom: 2rem;
  color: #333 !important;
  max-width: 550px;
}

.cta-logo img {
  width: 160px;
  height: auto;
  filter: drop-shadow(0 2px 6px rgba(0,0,0,0.2));
}

/* Button */
.cta-btn {
  display: inline-block;
  background: #f15a29;
  color: #fff;
  font-weight: 700;
  font-size: 1.25rem;
  padding: 1rem 2rem;
  text-decoration: none;
  border: none;
  cursor: pointer;
  transition: background 0.25s ease, transform 0.25s ease;
}

.cta-btn:hover {
  background: #d94e21;
  transform: translateY(-2px);
}

/* ✅ Responsive */
@media (max-width: 989px) {
  .cta-wrapper {
    grid-template-columns: 1fr;
    text-align: center;
    padding: 3rem 0rem;
  }
  .cta-col {
    text-align: center;
  }
  .cta-text {
    text-align: left;
  }
  .cta-logo img {
    margin: 0 auto;
  }
}
</style>

{% schema %}
{
  "name": "Crafted in USA CTA",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image",
      "info": "Upload the background image"
    },
    {
      "type": "text",
      "id": "left_heading",
      "label": "Left Heading",
      "default": "Crafted in the USA"
    },
    {
      "type": "textarea",
      "id": "left_text",
      "label": "Left Description",
      "default": "Every Shoreline Brands sunshade kit is proudly hand-sewn in Lancaster, Pennsylvania. We use premium materials like carbon fiber poles and aluminum brackets to deliver durable, long-lasting performance you can rely on."
    },
    {
      "type": "image_picker",
      "id": "left_logo",
      "label": "Left Logo"
    },
    {
      "type": "text",
      "id": "right_heading",
      "label": "Right Heading",
      "default": "Where We’re Headed"
    },
    {
      "type": "textarea",
      "id": "right_text",
      "label": "Right Description",
      "default": "Every Shoreline Brands sunshade kit is proudly hand-sewn in Lancaster, Pennsylvania. We use premium materials like carbon fiber poles and aluminum brackets to deliver durable, long-lasting performance you can rely on."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    { "name": "Crafted in USA CTA" }
  ]
}
{% endschema %}
