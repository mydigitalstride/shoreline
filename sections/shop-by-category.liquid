<section class="shop-by-category">
  <div class="category-wrapper">
    <!-- LEFT SIDE -->
    <div class="category-left">
      <h2 class="category-heading">{{ section.settings.heading }}</h2>

      <div class="category-grid">
        {% for block in section.blocks %}
          <a href="{{ block.settings.link }}" class="category-card">
            <div class="category-image" 
              style="background-image:url('{{ block.settings.image | image_url: width: 600 }}');">
            </div>
            <div class="category-label">{{ block.settings.title }}</div>
          </a>
        {% endfor %}
      </div>
    </div>

    <!-- RIGHT SIDE BACKGROUND IMAGE -->
    <div class="category-right"
      {% if section.settings.right_image %}
        style="background-image:url('{{ section.settings.right_image | image_url: width: 1600 }}');"
      {% endif %}
    ></div>
  </div>
</section>

{% stylesheet %}
/* === SECTION BASE === */
.shop-by-category {
  background: #fff;
  color: #1c2b47;
  overflow: hidden;
}

.category-wrapper {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  align-items: stretch;
  position: relative;
}

/* LEFT SIDE */
.category-left {
  padding: 5rem 3rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.category-heading {
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 800;
  text-transform: uppercase;
  margin-bottom: 3rem;
  color: #1c2b47;
}

/* GRID CARDS */
.category-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 2rem;
  max-width: 600px;
}

.category-card {
  display: flex;
  flex-direction: column;
  text-align: center;
  text-decoration: none;
  position: relative;
  overflow: hidden;
  transition: all 0.4s ease;
}

.category-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 10px 20px rgba(0,0,0,0.15);
}

/* IMAGE AREA */
.category-image {
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  height: 260px;
  position: relative;
}

/* LABEL */
.category-label {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  text-transform: uppercase;
  font-weight: 700;
  font-size: 1.1rem;
  color: #fff;
  background: linear-gradient(180deg, transparent, rgba(0,0,0,0.7));
  padding: 1rem;
}

/* RIGHT SIDE IMAGE */
.category-right {
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  clip-path: polygon(10% 0, 100% 0, 100% 100%, 0 100%);
}

/* RESPONSIVE */
@media (max-width: 989px) {
  .category-wrapper {
    grid-template-columns: 1fr;
  }

  .category-right {
    clip-path: none;
    height: 300px;
  }

  .category-left {
    text-align: center;
    align-items: center;
  }

  .category-grid {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 600px) {
  .category-grid {
    grid-template-columns: 1fr;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Shop by Category",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Shop by Category"
    },
    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Right Side Image"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Name",
          "default": "T-Shirts"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category Link"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Shop by Category",
      "blocks": [
        { "type": "category", "settings": { "title": "T-Shirts" } },
        { "type": "category", "settings": { "title": "Hats" } }
      ]
    }
  ]
}
{% endschema %}
