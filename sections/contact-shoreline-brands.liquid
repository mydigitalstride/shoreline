<section class="contact-shoreline">
  <style>
    .contact-shoreline {
      background: linear-gradient(90deg, #dee1e7 0%, #f0f2f6 100%);
      padding: 4rem 3rem;
      color: #1c2a49 !important;
    }
    .contact-shoreline__wrapper {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 2rem;
      flex-wrap: wrap;
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }
    .contact-shoreline__info { flex: 1 1 40%; }
    .contact-shoreline__info h2 {
      font-size: 2rem; font-weight: 700; margin-bottom: 1rem;
    }
    .contact-shoreline__info p {
      font-size: 1rem; margin-bottom: 0.5rem; color:black !important;
    }
    .contact-shoreline__info a { color: #000; text-decoration: none; }

    .contact-shoreline__info h3 {
      margin-top: 2rem;
      font-size: 1.5rem;
      font-weight: 700;
      letter-spacing: 0.4px;
    }

    .contact-shoreline__buttons {
      display: flex; gap: 1rem; margin-top: 1rem;
    }
    .contact-btn {
      background: #e76a3b; 
      color: #fff; 
      padding: 12px 28px;
      font-weight: 600; 
      text-transform: uppercase;
      border: none; 
      border-radius: 2px; 
      text-decoration: none;
      transition: all 0.3s ease;
    }
    .contact-btn:hover { opacity: 0.85; }

    .contact-shoreline__form { flex: 1 1 50%; }
    .contact-shoreline__form input,
    .contact-shoreline__form textarea {
      width: 100%; padding: 12px; margin-bottom: 1rem;
      border: none; background-color: #b7bfd8;
      color: #1c2a49; font-weight: 600; border-radius: 4px;
    }
    .contact-shoreline__row { display: flex; gap: 1rem; }

    .file-upload label {
      background-color: #b7bfd8; 
      color: #1c2a49; 
      font-weight: 600;
      display: inline-block; 
      padding: 10px 20px; 
      border-radius: 4px; 
      cursor: pointer; 
      margin-bottom: 0.5rem;
    }

    /* 🔴 Upload Required Message */
    .upload-required-msg {
      color: #d32f2f; /* red */
      font-size: 0.9rem;
      font-weight: 600;
      margin: 0 0 0.75rem;
    }

    .file-upload input[type="file"] { display: none; }

    .submit-btn {
      width: 100%;
      background-color: #e76a3b;  /* orange */
      color: #ffffff;             /* white text */
      font-weight: 700;
      text-transform: uppercase;
      padding: 14px;
      border: none;
      border-radius: 0;           /* squared */
      cursor: pointer;
      transition: background 0.2s ease;
    }

    .submit-btn:hover { 
      background-color:#d45c2c;
    }
  </style>

  <div class="contact-shoreline__wrapper">
    <div class="contact-shoreline__info">

      <!-- Editable Heading -->
      <h2>{{ section.settings.heading }}</h2>

      <!-- Editable Email -->
      <p><strong>Email:</strong>
        <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
      </p>

      <!-- Editable Phone -->
      <p><strong>Phone:</strong>
        <a href="tel:{{ section.settings.phone | replace: ' ', '' }}">{{ section.settings.phone }}</a>
      </p>

      <h3>{{ section.settings.quick_links_heading }}</h3>

      <!-- Dynamic Link Buttons -->
      <div class="contact-shoreline__buttons">
        {% for block in section.blocks %}
          <a href="{{ block.settings.link }}" class="contact-btn">
            {{ block.settings.label }}
          </a>
        {% endfor %}
      </div>
    </div>

    <!-- Contact Form -->
    <div class="contact-shoreline__form">
      <form method="post" action="/contact#contact_form" id="contact_form" accept-charset="UTF-8" enctype="multipart/form-data">
        <input type="hidden" name="form_type" value="contact" />

        <div class="contact-shoreline__row">
          <input type="text" name="contact[name]" placeholder="Name" required>
          <input type="text" name="contact[phone]" placeholder="Number">
        </div>

        <input type="email" name="contact[email]" placeholder="Email" required>
        <textarea name="contact[body]" rows="5" placeholder="Message"></textarea>

        <div class="file-upload">
          <label for="contact_file">Upload File</label>

          {% if section.settings.upload_required %}
            <p class="upload-required-msg">Please upload a file before submitting this form.</p>
          {% endif %}

          <input
            type="file"
            id="contact_file"
            name="contact[file]"
            {% if section.settings.upload_required %}
              required
            {% endif %}
          >
        </div>

        <button type="submit" class="submit-btn">Submit</button>
      </form>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact Shoreline Brands",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact Shoreline Brands" },
    { "type": "text", "id": "email", "label": "Email", "default": "info@shorelinebrands.com" },
    { "type": "text", "id": "phone", "label": "Phone Number", "default": "+1-123-456-7890" },
    { "type": "text", "id": "quick_links_heading", "label": "Quick Links Heading", "default": "Quick Links:" },

    {
      "type": "checkbox",
      "id": "upload_required",
      "label": "Make file upload required?",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Quick Link",
      "settings": [
        { "type": "text", "id": "label", "label": "Button Text", "default": "FAQ" },
        { "type": "url", "id": "link", "label": "Link URL" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    { "name": "Contact Shoreline Brands" }
  ]
}
{% endschema %}
