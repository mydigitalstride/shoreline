<section class="features-and-categories">
  <div class="page-width">

    <!-- Feature Icons Row -->
    <div class="features-row">
      {% for block in section.blocks %}
        {% if block.type == 'feature' %}
          <div class="feature-item">
            {% if block.settings.icon %}
              <img src="{{ block.settings.icon | image_url: width: 80 }}" alt="{{ block.settings.title }}">
            {% endif %}
            <div>
              <h4>{{ block.settings.title }}</h4>
              <p>{{ block.settings.text }}</p>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="feature-divider"></div>

    <!-- Shop by Category -->
    <div class="categories-wrapper">
      <h2 class="categories-heading">{{ section.settings.heading }}</h2>
    </div>

    <div class="categories-grid">
      {% for block in section.blocks %}
        {% if block.type == 'category' %}
          <a href="{{ block.settings.link }}" class="category-cards">
            <div class="category-image" style="background-image:url('{{ block.settings.image | image_url: width: 900 }}');">
              <div class="category-overlay"></div>
              <span class="category-title">{{ block.settings.title }}</span>
            </div>
          </a>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</section>

{% stylesheet %}

/* SECTION WRAPPER */
.features-and-categories {
  --teal: #46b3b8;
  background:#2c3c5e;
  color:#fff;
  padding: 4rem 5rem !important;
  text-align:center;
}

/* FEATURES ROW */
.features-row {
  max-width:var(--content-max);
  margin:0 auto 1.75rem;
  display:flex;flex-wrap:wrap;
  gap:3.5rem;
  justify-content:center;
  align-items:flex-start;
}
.feature-item{display:flex;gap:.9rem;align-items:center;text-align:left}
.feature-item img{width:70px}
.feature-item h4{
  font:500 1.5rem/1 "Bebas Neue",sans-serif;
  letter-spacing:.4px;
  text-transform:uppercase;
  margin:0
}
.feature-item p{
  font:400 1rem/1.4 "Heebo",sans-serif;
  color:white !important;
  margin:0
}
p { color:white !important; }

/* DIVIDER */
.feature-divider{
  height:3px;width:65%;
  max-width:var(--content-max);
  margin:1.25rem auto 2.25rem;
  background:var(--teal);
  border-radius:3px;
}

/* CATEGORY HEADING */
.categories-wrapper{
  max-width:var(--content-max);
  margin:0 auto 1.75rem;
  text-align:left;
}
.categories-heading{
  font-family:"League Spartan",sans-serif;
  font-weight:800;
  letter-spacing:3px;
  font-size:3rem;
  margin:0;
  text-transform:uppercase;
}

/* GRID */
.categories-grid {
  display:flex;
  justify-content:center;
  align-items:stretch;
  flex-wrap:wrap;
  gap:3rem;
  max-width:var(--content-max);
  margin:0 auto;
  padding-top:.5rem;
}

/* CARD */
.category-cards {
  flex:0 1 320px !important;
  display:block;
  text-decoration:none;
  overflow:hidden;
  transition: transform .3s ease;
  cursor:pointer;
}

.category-image {
  aspect-ratio: 1 / 1;
  background-size:cover;
  background-position:center;
  display:flex;
  align-items:flex-end;
  justify-content:center;
  padding:1rem;
  position:relative;
  box-shadow:0 8px 24px rgba(0,0,0,.25);
  transition:transform .3s ease;
}

/* HOVER SCALE */
.category-cards:hover .category-image { transform:scale(1.02); }

/* 🌟 FIXED OVERLAY — DEFAULT OPACITY + TEAL HOVER */
.category-overlay {
  position:absolute;
  inset:0;
  background:linear-gradient(
    to top,
    rgba(70,179,184,0.85),
    rgba(70,179,184,0.35)
  );
  opacity:.25;                       /* DEFAULT OPACITY */
  transform:translateY(10%);         /* subtle start */
  transition:opacity .45s ease, transform .45s ease;
  pointer-events:none;
}

/* HOVER — FULL TEAL + SLIDE UP */
.category-cards:hover .category-overlay {
  opacity:1;
  transform:translateY(0);
}

/* TITLE */
.category-title{
  position:relative;
  z-index:2;
  font:700 1rem/1 "League Spartan",sans-serif;
  text-transform:uppercase;
  letter-spacing:1px;
  color:#fff;
  margin-bottom:.6rem;
  text-shadow:0 2px 6px rgba(0,0,0,.35);
}

/* ---------- RESPONSIVE ---------- */
@media (max-width:1024px){
  .features-and-categories{padding:3rem 2rem !important}
  .features-row{gap:2.5rem}
  .feature-item{flex:1 1 45%;text-align:center;justify-content:center}
  .categories-heading{text-align:center;font-size:2.4rem}
  .category-cards{flex:0 1 280px !important}
}

@media (max-width:749px){
  .features-and-categories{padding:3rem 1.5rem !important}
  .features-row{flex-direction:column;align-items:center;gap:1.5rem}
  .feature-divider{width:80%}
  .categories-grid{flex-direction:column;align-items:center;gap:1.5rem}
  .category-cards{max-width:320px;margin:0 auto}
  .category-image{height:250px}
}

@media (max-width:480px){
  .category-image{height:220px}
  .categories-heading{font-size:1.7rem}
}

{% endstylesheet %}

{% schema %}
{
  "name": "Features & Categories",
  "settings": [
    { "type": "text", "id": "heading", "label": "Category Heading", "default": "Shop by Category" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Item",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Feature Icon" },
        { "type": "text", "id": "title", "label": "Feature Title" },
        { "type": "text", "id": "text", "label": "Feature Description" }
      ]
    },
    {
      "type": "category",
      "name": "Category Item",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Category Image" },
        { "type": "text", "id": "title", "label": "Category Title" },
        { "type": "url", "id": "link", "label": "Category Link" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Features & Categories",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
