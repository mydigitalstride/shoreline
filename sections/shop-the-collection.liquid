<section class="shop-the-collection"
  {% if section.settings.background_image %}
    style="background-image: url('{{ section.settings.background_image | image_url: width: 2000 }}');"
  {% endif %}
>
  <div class="collection-wrapper">
    <!-- SECTION HEADING -->
    <h2 class="collection-heading">{{ section.settings.heading }}</h2>

    <!-- FEATURE ICON ROW -->
    <div class="collection-features">
      {% for block in section.blocks %}
        {% if block.type == 'feature' %}
          <div class="feature-item">
            {% if block.settings.icon %}
              <img src="{{ block.settings.icon | image_url: width: 80 }}" alt="{{ block.settings.title }}" class="feature-icon">
            {% endif %}
            <div class="feature-text">
              <h4>{{ block.settings.title }}</h4>
              {% if block.settings.text_top != blank %}
                <p>{{ block.settings.text_top }}</p>
              {% endif %}
              {% if block.settings.text_bottom != blank %}
                <p>{{ block.settings.text_bottom }}</p>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <!-- PRODUCT GRID -->
    <div class="collection-grid">
      {% if section.settings.products and section.settings.products.size > 0 %}
        {% for product in section.settings.products %}
          <div class="product-card">
            {% if product.featured_image %}
              <img 
                src="{{ product.featured_image | image_url: width: 600 }}" 
                alt="{{ product.title | escape }}" 
                class="product-image"
              >
            {% endif %}
            <h3 class="product-title">{{ product.title }}</h3>
            <div class="product-price">{{ product.price | money }}</div>
            <a href="{{ product.url }}" class="product-btn">View Product</a>
          </div>
        {% endfor %}
      {% else %}
        <p>No products selected or found.</p>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
/* === BASE SECTION === */
.shop-the-collection {
  background-color: #fff;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  text-align: center;
  padding: 4rem 2rem 6rem;
  color: #1c2b47;
  position: relative;
}

.shop-the-collection::before {
  content: "";
  position: absolute;
  inset: 0;
  background: rgba(255, 255, 255, 0.7);
  z-index: 0;
}

.collection-wrapper {
  position: relative;
  z-index: 1;
}

.collection-heading {
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 800;
  text-transform: capitalize;
  margin-bottom: 3rem;
  text-align: left;
}

/* FEATURES */
.collection-features {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  flex-wrap: nowrap;
  gap: 4rem;
  margin-bottom: 4rem;
  text-align: left;
}

.feature-item {
  display: flex;
  align-items: center;
  gap: 1.25rem;
  flex: 1;
  min-width: 250px;
}

.feature-icon {
  width: 80px;
  height: auto;
  flex-shrink: 0;
  filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.15));
}

.feature-text h4 {
  font-weight: 800;
  font-size: 1.1rem;
  text-transform: uppercase;
  margin: 0 0 0.25rem 0;
  color: #1c2b47;
}

.feature-text p {
  margin: 0;
  font-size: 0.9rem;
  color: #333;
  line-height: 1.3;
}

/* PRODUCT GRID */
.collection-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2rem;
  justify-items: center;
}

.product-card {
  text-align: center;
  background: #fff;
  transition: all 0.3s ease;
  width: 100%;
  max-width: 270px;
  border-radius: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-card:hover {
  transform: translateY(-4px);
}

.product-image {
  width: 100%;
  height: auto; /* keep all equal size */
  object-fit: cover;
  display: block;
}

.product-title {
  font-size: 1.5rem;
  font-weight: 800;
  text-transform: uppercase;
  margin: 1rem 0 0.5rem;
  color: #1c2b47;
  letter-spacing: 1px;
}

.product-price {
  font-weight: 700;
  color: #1c2b47;
  margin-bottom: 0.5rem;
  color:#1c2b47 !important;
  font-family: 'League Spartan', sans-serif;
}

.product-btn {
  display: inline-block;
  background: #e76c3c;
  color: #fff;
  text-decoration: none;
  font-weight: 700;
  padding: 0.8rem 2rem;
  text-transform: capitalize;
  transition: all 0.3s ease;
}

.product-btn:hover {
  background: #d45c2c;
}

/* RESPONSIVE */
@media (max-width: 1200px) {
  .collection-grid { grid-template-columns: repeat(3, 1fr); }
}
@media (max-width: 900px) {
  .collection-features { flex-wrap: wrap; justify-content: center; }
  .feature-item { flex-direction: column; text-align: center; }
  .collection-grid { grid-template-columns: repeat(2, 1fr); }
  .collection-heading { text-align: center; }
}
@media (max-width: 600px) {
  .collection-grid { grid-template-columns: 1fr; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "All Products Grid",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "All Products"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Select Products to Display"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Item",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Feature Icon" },
        { "type": "text", "id": "title", "label": "Feature Title", "default": "Durable" },
        { "type": "text", "id": "text_top", "label": "Top Text" },
        { "type": "text", "id": "text_bottom", "label": "Bottom Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "All Products Grid",
      "settings": {
        "heading": "All Products"
      },
      "blocks": [
        { "type": "feature", "settings": { "title": "Durable" } },
        { "type": "feature", "settings": { "title": "Stylish" } },
        { "type": "feature", "settings": { "title": "Premium Quality" } }
      ]
    }
  ]
}
{% endschema %}
