<section class="custom-footer">
  <div class="footer-wrapper page-width">

    <!-- Left Logo -->
    <div class="footer-logo">
      {% if section.settings.left_logo %}
        <a href="/" class="footer-logo-button" aria-label="Home">
          <img src="{{ section.settings.left_logo | image_url: width: 200 }}" alt="Left Logo">
        </a>
      {% endif %}
    </div>

    <!-- Navigation Columns -->
    <div class="footer-links">
      {% for block in section.blocks %}
        {% if block.type == 'footer_column' %}
          <div class="footer-column">
            {% if block.settings.heading %}
              <h4>
                {% if block.settings.heading_link != blank %}
                  <a href="{{ block.settings.heading_link }}">{{ block.settings.heading }}</a>
                {% else %}
                  {{ block.settings.heading }}
                {% endif %}
              </h4>
            {% endif %}
            <ul>
              {% for i in (1..5) %}
                {% capture link_text_key %}link_text_{{ i }}{% endcapture %}
                {% capture link_url_key %}link_url_{{ i }}{% endcapture %}
                {% assign link_text = block.settings[link_text_key] %}
                {% assign link_url = block.settings[link_url_key] %}
                {% if link_text != blank %}
                  <li><a href="{{ link_url | default: '#' }}">{{ link_text }}</a></li>
                {% endif %}
              {% endfor %}
            </ul>

            {% if block.settings.heading contains 'Contact' %}
              <div class="contact-icons">
                {% if section.settings.facebook %}
                  <a href="{{ section.settings.facebook }}" target="_blank" aria-label="Facebook" class="social-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M22 12c0-5.522-4.478-10-10-10S2 6.478 2 12c0 4.991
                      3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506
                      1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243
                      0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343
                      21.128 22 16.991 22 12z"/>
                    </svg>
                  </a>
                {% endif %}
                {% if section.settings.contact_email %}
                  <a href="mailto:{{ section.settings.contact_email }}" aria-label="Email" class="social-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M20 4H4c-1.103 0-2 .897-2 2v12c0
                      1.103.897 2 2 2h16c1.103 0 2-.897
                      2-2V6c0-1.103-.897-2-2-2zm0
                      2v.511l-8 5.333-8-5.333V6h16zM4
                      18V8.489l8 5.333 8-5.333V18H4z"/>
                    </svg>
                  </a>
                {% endif %}
                {% if section.settings.instagram %}
                  <a href="{{ section.settings.instagram }}" target="_blank" aria-label="Instagram" class="social-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M7 2C4.243 2 2 4.243 2 7v10c0
                      2.757 2.243 5 5 5h10c2.757 0 5-2.243
                      5-5V7c0-2.757-2.243-5-5-5H7zm0
                      2h10c1.654 0 3 1.346 3
                      3v10c0 1.654-1.346 3-3
                      3H7c-1.654 0-3-1.346-3-3V7c0-1.654
                      1.346-3 3-3zm5 2c-2.757
                      0-5 2.243-5 5s2.243 5 5
                      5 5-2.243 5-5-2.243-5-5-5zm0
                      2c1.654 0 3 1.346 3
                      3s-1.346 3-3 3-3-1.346-3-3
                      1.346-3 3-3zm4.5-.5a1.5 1.5
                      0 100 3 1.5 1.5 0 000-3z"/>
                    </svg>
                  </a>
                {% endif %}
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <!-- Divider -->
    <div class="footer-divider"></div>

    <!-- Right Logo -->
    <div class="footer-badge">
      {% if section.settings.right_logo %}
        <img src="{{ section.settings.right_logo | image_url: width: 120 }}" alt="Right Logo">
      {% endif %}
    </div>
  </div>

  <!-- Payment Icons -->
  <div class="footer-payments">
    {% for block in section.blocks %}
      {% if block.type == 'payment' %}
        <img src="{{ block.settings.payment_icon | image_url: width: 80 }}" alt="Payment Icon" class="payment-icon">
      {% endif %}
    {% endfor %}
  </div>
</section>

{% stylesheet %}
.custom-footer {
  background: #fff;
  padding: 3rem 2rem 1rem;
}

/* Layout */
.footer-wrapper {
  display: grid;
  grid-template-columns: auto 1fr auto;
  grid-template-rows: auto auto;
  gap: 2rem;
  align-items: flex-start;
}

.footer-logo {
  grid-row: 1;
  grid-column: 1;
}

.footer-links {
  grid-row: 1;
  grid-column: 2;
}

.footer-badge {
  grid-row: 1;
  grid-column: 3;
}

/* Logos */
.footer-logo a { display: inline-block; transition: transform 0.2s ease; }
.footer-logo a:hover { transform: scale(1.05); }

/* Columns */
.footer-links {
  display: flex;
  justify-content: center;
  gap: 4rem;
  flex-wrap: wrap;
}
.footer-column h4 {
  font-weight: 500;
  margin-bottom: 1rem;

}
.footer-column h4 a {
  color: #1c2b47;
  text-decoration: none;
  transition: color 0.2s ease;
  font-size: 1.5rem;
  letter-spacing: 1px;
}
.footer-column h4 a:hover { color: #f15a29; }

.footer-column ul {
  list-style: none;
  margin: 0;
  padding: 0;
}
.footer-column a {
  text-decoration: none;
  color: #2c3c5e;
  transition: color 0.2s ease;
  font-size: 1rem;
}
.footer-column a:hover { color: #f15a29; }

/* Contact Icons */
.contact-icons {
  display: flex;
  gap: 0.75rem;
  margin-top: 0.75rem;
}
.contact-icons a svg {
  fill: #1f2d50;
  transition: fill 0.2s ease;
}
.contact-icons a:hover svg { fill: #f15a29; }

/* Divider & Payments */
.footer-divider {
  height: 2px;
  width: 100%;
  grid-row: 2;
  grid-column: 1 / -1;
  margin: 2rem 0;
  background: linear-gradient(to right, #448b8d, #98cceb, transparent);
  border-radius: 1px;
}
.footer-payments {
  margin-top: 1rem;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
  gap: 1rem;
}
.footer-payments img {
  height: 28px;
  width: auto;
}

/* Responsive */
@media (max-width: 1024px) {
  .footer-wrapper { grid-template-columns: 1fr 1fr; }
  .footer-logo,
  .footer-badge { grid-column: 1 / -1; justify-content: center; }
}
@media (max-width: 768px) {
  .footer-wrapper {
    grid-template-columns: 1fr;
    grid-template-rows: auto auto auto auto;
    text-align: center;
  }

  .footer-logo {
    grid-row: 1;
    grid-column: 1;
    max-width: 50vw;
    margin: 0 auto;
  }

  .footer-links {
    grid-row: 2;
    grid-column: 1;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  .contact-icons {
    justify-content: center;
  }

  .footer-divider {
    grid-row: 3;
    grid-column: 1;
    margin: 0;
  }

  .footer-badge {
    grid-row: 4;
    grid-column: 1;
    max-width: 50vw;
    margin: 0 auto;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Custom Footer",
  "settings": [
    { "type": "image_picker", "id": "left_logo", "label": "Left Logo" },
    { "type": "image_picker", "id": "right_logo", "label": "Right Logo" },
    { "type": "text", "id": "contact_email", "label": "Contact Email" },
    { "type": "url", "id": "facebook", "label": "Facebook Link" },
    { "type": "url", "id": "instagram", "label": "Instagram Link" }
  ],
  "blocks": [
    {
      "type": "footer_column",
      "name": "Footer Column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Column Heading (e.g. Shop, About, Contact)" },
        { "type": "url", "id": "heading_link", "label": "Heading Link (optional)" },
        { "type": "text", "id": "link_text_1", "label": "Link 1 Text" },
        { "type": "url", "id": "link_url_1", "label": "Link 1 URL" },
        { "type": "text", "id": "link_text_2", "label": "Link 2 Text" },
        { "type": "url", "id": "link_url_2", "label": "Link 2 URL" },
        { "type": "text", "id": "link_text_3", "label": "Link 3 Text" },
        { "type": "url", "id": "link_url_3", "label": "Link 3 URL" },
        { "type": "text", "id": "link_text_4", "label": "Link 4 Text" },
        { "type": "url", "id": "link_url_4", "label": "Link 4 URL" },
        { "type": "text", "id": "link_text_5", "label": "Link 5 Text" },
        { "type": "url", "id": "link_url_5", "label": "Link 5 URL" }
      ]
    },
    {
      "type": "payment",
      "name": "Payment Icon",
      "settings": [
        { "type": "image_picker", "id": "payment_icon", "label": "Payment Logo" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Footer",
      "blocks": [
        { "type": "footer_column" },
        { "type": "footer_column" },
        { "type": "footer_column" }
      ]
    }
  ]
}
{% endschema %}
