<section class="shade-finder-section">
  <div class="page-width">

    <!-- === TOP 3 PRODUCT CARDS === -->
    <div class="extensions-grid">
      {% for block in section.blocks %}
        {% if block.type == 'extension_card' %}
          <div class="extension-card">
            <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title }}">
            <div class="card-content">
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <!-- === FINDER === -->
    <div class="finder-area">
      <h2 class="finder-heading">{{ section.settings.heading }}</h2>

      <div class="finder-layout">
        <!-- LEFT FILTERS -->
        <div class="finder-filters">
          <select id="yearSelect" class="finder-select">
            <option value="">Select Year</option>
          </select>

          <select id="makeSelect" class="finder-select">
            <option value="">Select Make</option>
          </select>

          <select id="modelSelect" class="finder-select" disabled>
            <option value="">Select Model</option>
          </select>

          <div class="finder-buttons">
            <button id="clearBtn" class="clear-btn">CLEAR</button>
            <button id="searchBtn" class="search-btn">SEARCH</button>
          </div>
        </div>

        <!-- RIGHT RESULTS -->
        <div class="finder-results" id="resultsContainer"></div>
      </div>
    </div>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const yearSelect = document.getElementById('yearSelect');
  const makeSelect = document.getElementById('makeSelect');
  const modelSelect = document.getElementById('modelSelect');
  const searchBtn = document.getElementById('searchBtn');
  const clearBtn = document.getElementById('clearBtn');
  const resultsContainer = document.getElementById('resultsContainer');
  let data = [];

  // Load boat data from JSON
  fetch('{{ "boats.json" | asset_url }}')
    .then(res => res.json())
    .then(json => {
      data = json;
      const years = [...new Set(data.map(item => String(item.Year)))].sort();
      const makes = [...new Set(data.map(item => item.Make))].sort();

      populateSelect(yearSelect, years);
      populateSelect(makeSelect, makes);
    })
    .catch(err => console.error("Error loading boats.json:", err));

  // Populate dropdowns
  function populateSelect(select, values) {
    select.innerHTML += values.map(v => `<option value="${v}">${v}</option>`).join("");
  }

  // Update models dynamically based on year/make
  function updateModels() {
    const selectedYear = yearSelect.value;
    const selectedMake = makeSelect.value;

    const filteredModels = data
      .filter(item =>
        (!selectedYear || String(item.Year) === selectedYear) &&
        (!selectedMake || item.Make?.toLowerCase() === selectedMake.toLowerCase())
      )
      .map(item => item.Model);

    const uniqueModels = [...new Set(filteredModels)].sort();
    modelSelect.innerHTML = `<option value="">Select Model</option>`;
    modelSelect.innerHTML += uniqueModels.map(m => `<option value="${m}">${m}</option>`).join("");
    modelSelect.disabled = uniqueModels.length === 0;
  }

  yearSelect.addEventListener('change', updateModels);
  makeSelect.addEventListener('change', updateModels);

  // Search
  searchBtn.addEventListener('click', function() {
    const year = yearSelect.value;
    const make = makeSelect.value;
    const model = modelSelect.value;

    const filtered = data.filter(item =>
      (!year || String(item.Year) === year) &&
      (!make || item.Make?.toLowerCase() === make.toLowerCase()) &&
      (!model || item.Model?.toLowerCase() === model.toLowerCase())
    );

    displayResults(filtered);
  });

  // Clear
  clearBtn.addEventListener('click', function() {
    yearSelect.value = '';
    makeSelect.value = '';
    modelSelect.value = '';
    modelSelect.disabled = true;
    resultsContainer.innerHTML = '';
  });

  // Display results
  function displayResults(results) {
    if (!results.length) {
      resultsContainer.innerHTML = '<p class="no-results">No results found.</p>';
      return;
    }

    resultsContainer.innerHTML = results.map(item => `
      <div class="result-row">
        <span>${item.Year}</span>
        <span>${item.Make}</span>
        <span>${item.Model}</span>
        <a href="${item.link || '#'}" target="_blank" class="view-link">View</a>
      </div>
    `).join('');
  }
});
</script>
{% stylesheet %}
/* === BACKGROUND === */
.shade-finder-section {
  background: linear-gradient(180deg, #6bb5b8 0%, #1c2b47 100%);
  padding: 4rem 2rem;
  color: #fff;
}

/* === EXTENSION CARDS === */
.extensions-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 5rem;
  margin-bottom: 4rem;
}

.extension-card {
  background: #1c2b47;
  overflow: hidden;
  padding: 2rem 1.5rem 2.5rem;
  text-align: center;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.15);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.extension-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
}

/* Image centered and smaller */
.extension-card img {
  width: 80%;
  max-width: 260px;
  height: auto;
  margin: 0 auto 1.5rem;
  object-fit: cover;
}

/* Card text styling */
.card-content {
  max-width: 90%;
  margin: 0 auto;
}

.card-content h3 {
  font-family: "League Spartan", sans-serif;
  font-weight: 800;
  font-size: 1.15rem;
  text-transform: uppercase;
  line-height: 1.3;
  margin-bottom: 0.75rem;
  color: #ffffff;
}

.card-content p {
  font-family: "Heebo", sans-serif;
  color: #dcdcdc;
  font-size: 0.95rem;
  line-height: 1.6;
}

/* === FINDER === */
.finder-area {
  padding: 2rem 0;
}
.finder-heading {
  font-family: "League Spartan", sans-serif;
  text-align: center;
  font-size: 2.3rem;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 3rem;
}
.finder-layout {
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: 3rem;
  align-items: start;
}

/* LEFT FILTERS */
.finder-filters {
  display: flex;
  flex-direction: column;
  gap: 1.2rem;
}
.finder-select {
  padding: 1rem;
  border: 3px solid #1c2b47;
  font-size: 1rem;
  font-weight: 700;
  background: #fff;
  color: #1c2b47;
  text-align: center;
 
  cursor: pointer;
}
.finder-buttons {
  display: flex;
  gap: 1rem;
  margin-top: 1rem;
}
.search-btn,
.clear-btn {
  flex: 1;
  padding: 0.75rem;
  font-weight: 800;
  text-transform: uppercase;
  color: #fff;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  font-family: "League Spartan", sans-serif;
}
.search-btn { background: #f15a29; }
.search-btn:hover { background: #d94e21; }
.clear-btn { background: #f15a29; opacity: 0.9; }
.clear-btn:hover { opacity: 1; }

/* RIGHT RESULTS */
.finder-results {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}
.result-row {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr auto;
  background: white;
  color: #1c2b47;
  font-weight: 700;
  padding: 1rem;
  text-align: center;
  font-family: "Heebo", sans-serif;
  align-items: center;
}
.view-link {
  background: #1c2b47;
  color: #fff;
  padding: 0.5rem 1rem;
  border-radius: 3px;
  text-decoration: none;
  font-weight: 700;
}
.view-link:hover {
  background: #15223d;
}
.no-results {
  text-align: center;
  color: #fff;
  font-weight: 700;
}

/* === RESPONSIVE === */
@media (max-width: 989px) {
  .extensions-grid { grid-template-columns: 1fr 1fr; }
  .finder-layout { grid-template-columns: 1fr; }
}
@media (max-width: 600px) {
  .extensions-grid { grid-template-columns: 1fr; }
  .extension-card img {
    width: 90%;
    max-width: 220px;
  }
}
{% endstylesheet %}


{% schema %}
{
  "name": "Shade Finder Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Finder Heading",
      "default": "Find Your Shoreline Shade Bimini Extension"
    }
  ],
  "blocks": [
    {
      "type": "extension_card",
      "name": "Extension Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Card Image" },
        { "type": "text", "id": "title", "label": "Card Title" },
        { "type": "text", "id": "text", "label": "Card Description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shade Finder Section",
      "blocks": [
        { "type": "extension_card" },
        { "type": "extension_card" },
        { "type": "extension_card" }
      ]
    }
  ]
}
{% endschema %}
