<section class="shop-category-grid">
  <div class="page-width">
    <!-- HEADING -->
    {% if section.settings.heading != blank %}
      <h2 class="categories-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <!-- CATEGORY GRID -->
    <div class="categories-grid">
      {% for block in section.blocks %}
        {% if block.settings.link != blank %}
          <a href="{{ block.settings.link }}" class="category-card">
            <div class="category-image" style="background-image:url('{{ block.settings.image | image_url: width: 800 }}');">
              <div class="category-overlay"></div>
              <span class="category-title">{{ block.settings.title }}</span>
            </div>
          </a>
        {% else %}
          <div class="category-card no-link">
            <div class="category-image" style="background-image:url('{{ block.settings.image | image_url: width: 800 }}');">
              <div class="category-overlay"></div>
              <span class="category-title">{{ block.settings.title }}</span>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</section>

{% stylesheet %}
/* === SHOP CATEGORY GRID === */
.shop-category-grid {
  background: #1c2b47; /* deep navy */
  padding: 4rem 5rem;
  color: #fff;
  text-align: left;
}

.categories-heading {
  font-size: clamp(1.8rem, 3vw, 2.5rem);
  font-weight: 800;
  text-transform: uppercase;
  margin-bottom: 2.5rem;
  color: #ffffff;
  letter-spacing: 0.5px;
}

/* GRID */
.categories-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.5rem;
}

/* CARD */
.category-card {
  display: block; /* make the whole card clickable */
  position: relative;
  text-decoration: none;
  color: inherit;
  overflow: hidden;
  transition: transform 0.3s ease;
  cursor: pointer;
}

.category-card:hover {
  transform: scale(1.03);
}

/* IMAGE */
.category-image {
  background-size: cover;
  background-position: center;
  height: 280px;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 1.25rem;
  position: relative;
}

/* OVERLAY */
.category-overlay {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(70, 179, 184, 0.8), rgba(70, 179, 184, 0.4));
  opacity: 0.25;
  transition: opacity 0.4s ease;
  pointer-events: none; /* ✅ ensure clicks go through */
}

.category-card:hover .category-overlay {
  opacity: 1;
}

/* TITLE */
.category-title {
  position: relative;
  z-index: 2;
  font-size: 1.5rem;
  font-weight: 500;
  text-transform: uppercase;
  color: #fff;
  font-family: "Bebas Neue";
  letter-spacing: .75px;
  text-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
    @media (max-width: 768px) {
      font-size: 2rem;
      letter-spacing: 2px;
    }
}

/* RESPONSIVE */

/* Medium screens */
@media (max-width: 1200px) {
  .categories-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (max-width: 989px) {
  .categories-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

/* MOBILE FULL FIX */
@media (max-width: 600px) {

  .shop-category-grid {
    padding: 2.5rem 1.25rem;
    text-align: center;
  }

  .categories-heading {
    text-align: center;
    font-size: 1.9rem;
    margin-bottom: 2rem;
  }

  .categories-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    padding: 0;
  }

  .category-image {
    height: 0;
    padding-bottom: 100%; /* Square aspect ratio */
    position: relative;
    background-size: cover;
    background-position: center;
  }

  .category-overlay {
    position: absolute;
    inset: 0;
  }

  .category-title {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    font-size: clamp(1rem, 4vw, 1.5rem);
    letter-spacing: 0.5px;
    padding: 0.5rem;
    line-height: 1.2;
  }
}

/* Very small phones */
@media (max-width: 420px) {

  .category-image {
    padding-bottom: 100%; /* Keep square */
  }

  .category-title {
    font-size: clamp(0.9rem, 3.5vw, 1.2rem);
    letter-spacing: 0.5px;
    padding: 0.4rem;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Shop Category Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "Shade Solutions"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category Link"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Shop Category Grid",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
