<section class="shop-category-grid">
  <div class="page-width">

    {% if section.settings.heading != blank %}
      <h2 class="categories-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="categories-grid">
      {% for block in section.blocks %}
        {% if block.settings.link != blank %}
          <a href="{{ block.settings.link }}" class="category-card">
        {% else %}
          <div class="category-card no-link">
        {% endif %}

            <div class="category-image" style="background-image:url('{{ block.settings.image | image_url: width: 800 }}');">
              <div class="category-overlay"></div>

              <span 
                class="category-title pos-{{ block.settings.text_position }} align-{{ block.settings.text_alignment }}">
                {{ block.settings.title }}
              </span>
            </div>

        {% if block.settings.link != blank %}
          </a>
        {% else %}
          </div>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</section>

{% stylesheet %}
/* --------------------------------------------------
   SHOP CATEGORY GRID SECTION
-------------------------------------------------- */

.shop-category-grid {
  background: #1c2b47;
  padding: 4rem 5rem;
  color: #fff;
}

.categories-heading {
  font-size: clamp(1.8rem, 3vw, 2.5rem);
  font-weight: 800;
  text-transform: uppercase;
  margin-bottom: 2.5rem;
  color: #fff;
}

/* GRID */
.categories-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.5rem;
}

/* CARD */
.category-card {
  display: block;
  position: relative;
  text-decoration: none;
  color: inherit;
  overflow: hidden;
  cursor: pointer;
  transition: transform .3s ease;
}

.category-card:hover { transform: scale(1.03); }

/* IMAGE BLOCK */
.category-image {
  background-size: cover;
  background-position: center;
  aspect-ratio: 1 / 1;
  width: 100%;
  position: relative;
  border-radius: 12px;
  overflow: hidden;
}

/* OVERLAY */
.category-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(70,179,184,.8), rgba(70,179,184,.4));
  opacity: .25;
  transition: opacity .3s ease;
}

.category-card:hover .category-overlay {
  opacity: 1;
}

/* =======================
      TITLE STYLING
======================= */

.category-title {
  position: absolute;
  width: 100%;
  padding: .75rem;
  font-size: 1.6rem;
  font-family: "Bebas Neue";
  text-transform: uppercase;
  color: #fff;
  z-index: 2;
  text-shadow: 0 2px 6px rgba(0,0,0,.35);
}

/* --- TITLE POSITION --- */
.pos-top { top: .75rem; }
.pos-center { top: 50%; transform: translateY(-50%); }
.pos-bottom { bottom: .75rem; }

/* --- TEXT ALIGNMENT --- */
.align-left { text-align: left; }
.align-center { text-align: center; }
.align-right { text-align: right; }

/* --------------------------------------------------
   RESPONSIVE
-------------------------------------------------- */

/* Medium screens */
@media (max-width: 1200px) {
  .categories-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (max-width: 989px) {
  .categories-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

/* MOBILE — 1 PER ROW */
@media (max-width: 600px) {
  .shop-category-grid {
    padding: 2.5rem 1.25rem;
    text-align: center;
  }

  .categories-heading {
    text-align: center;
    margin-bottom: 2rem;
  }

  .categories-grid {
    grid-template-columns: 1fr; /* ← SINGLE COLUMN */
    gap: 1.2rem;
  }

  .category-title {
    font-size: 1.7rem;
    padding: .5rem .75rem;
  }
}

/* Extra small */
@media (max-width: 420px) {
  .category-title {
    font-size: 1.4rem;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Shop Category Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Item",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Category Image" },
        { "type": "text", "id": "title", "label": "Category Title", "default": "Category" },
        { "type": "url", "id": "link", "label": "Category Link" },

        {
          "type": "select",
          "id": "text_position",
          "label": "Title Position",
          "default": "bottom",
          "options": [
            { "value": "top", "label": "Top" },
            { "value": "center", "label": "Center" },
            { "value": "bottom", "label": "Bottom" }
          ]
        },

        {
          "type": "select",
          "id": "text_alignment",
          "label": "Title Alignment",
          "default": "center",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ]
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Shop Category Grid",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
