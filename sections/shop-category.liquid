<section class="shop-category-grid">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <h2 class="categories-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="categories-grid">
      {% for block in section.blocks %}
        {% if block.settings.link != blank %}
          <a href="{{ block.settings.link }}" class="category-card">
        {% else %}
          <div class="category-card no-link">
        {% endif %}

            <div class="category-image" style="background-image:url('{{ block.settings.image | image_url: width: 800 }}');">
              <div class="category-overlay"></div>

              <div class="category-content pos-{{ block.settings.text_position }}">
                <span class="category-title align-{{ block.settings.text_alignment }}">
                  {{ block.settings.title }}
                </span>
              </div>
            </div>

        {% if block.settings.link != blank %}
          </a>
        {% else %}
          </div>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</section>

{% stylesheet %}
/* ================================
   SHOP CATEGORY GRID - BASE
================================ */

.shop-category-grid {
  background: #1c2b47; /* deep navy */
  padding: 4rem 5rem;
  color: #fff;
}

.categories-heading {
  font-size: clamp(1.8rem, 3vw, 2.5rem);
  font-weight: 800;
  text-transform: uppercase;
  margin-bottom: 2.5rem;
  color: #ffffff;
  letter-spacing: 0.5px;
}

/* GRID */
.categories-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.5rem;
}

/* CARD */
.category-card {
  display: block;
  position: relative;
  text-decoration: none;
  color: inherit;
  overflow: hidden;
  transition: transform 0.3s ease;
  cursor: pointer;
}

.category-card:hover {
  transform: scale(1.03);
}

/* IMAGE BLOCK */
.category-image {
  background-size: cover;
  background-position: center;
  aspect-ratio: 1 / 1;
  width: 100%;
  position: relative;
  border-radius: 12px;
  overflow: hidden;
}

/* OVERLAY */
.category-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    rgba(70, 179, 184, 0.8),
    rgba(70, 179, 184, 0.4)
  );
  opacity: 0.25;
  transition: opacity 0.4s ease;
  pointer-events: none;
}

.category-card:hover .category-overlay {
  opacity: 1;
}

/* ================================
   TITLE & CONTENT LAYOUT
================================ */

/* wrapper that controls vertical position */
.category-content {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-end; /* default bottom */
  align-items: stretch;
  padding: 1rem;
  z-index: 2;
}

/* vertical options from schema */
.pos-top {
  justify-content: flex-start;
}

.pos-center {
  justify-content: center;
}

.pos-bottom {
  justify-content: flex-end; /* true bottom of the card */
}

/* actual title */
.category-title {
  width: 100%;
  font-size: 1.6rem;
  font-weight: 500;
  text-transform: uppercase;
  color: #fff;
  font-family: "Bebas Neue";
  letter-spacing: 0.75px;
  text-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
  padding: 0.35rem 0.6rem;
  box-sizing: border-box;
}

/* horizontal alignment options */
.align-left {
  text-align: left;
}

.align-center {
  text-align: center;
}

.align-right {
  text-align: right;
}

/* ================================
   RESPONSIVE
================================ */

/* Large tablet / small desktop */
@media (max-width: 1200px) {
  .categories-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

/* Tablet */
@media (max-width: 989px) {
  .categories-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

/* Mobile - 1 per row */
@media (max-width: 600px) {
  .shop-category-grid {
    padding: 2.5rem 1.25rem;
    text-align: center;
  }

  .categories-heading {
    text-align: center;
    font-size: 1.9rem;
    margin-bottom: 2rem;
  }

  .categories-grid {
    grid-template-columns: 1fr; /* one per row */
    gap: 1.2rem;
  }

  .category-title {
    font-size: 1.7rem;
    padding: 0.45rem 0.75rem;
  }
}

/* Very small phones */
@media (max-width: 420px) {
  .category-title {
    font-size: 1.4rem;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Shop Category Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category Link"
        },
        {
          "type": "select",
          "id": "text_position",
          "label": "Title Position",
          "default": "bottom",
          "options": [
            { "value": "top", "label": "Top" },
            { "value": "center", "label": "Center" },
            { "value": "bottom", "label": "Bottom" }
          ]
        },
        {
          "type": "select",
          "id": "text_alignment",
          "label": "Title Alignment",
          "default": "center",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ]
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Shop Category Grid",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
