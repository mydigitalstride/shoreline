<section class="shop-category-grid">
  <div class="page-width">

    {% if section.settings.heading != blank %}
      <h2 class="categories-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="categories-grid">
      {% for block in section.blocks %}

        {% assign linkwrap = block.settings.link %}
        {% if linkwrap != blank %}
          <a href="{{ linkwrap }}" class="category-card">
        {% else %}
          <div class="category-card no-link">
        {% endif %}

            <div class="category-image"
                 style="background-image:url('{{ block.settings.image | image_url: width: 800 }}');">

              <div class="category-overlay"></div>

              <!-- CONTENT POSITION CONTROLLER -->
              <div class="category-content pos-{{ block.settings.text_position }}">
                <span class="category-title align-{{ block.settings.text_alignment }}">
                  {{ block.settings.title }}
                </span>
              </div>

            </div>

        {% if linkwrap != blank %}
          </a>
        {% else %}
          </div>
        {% endif %}

      {% endfor %}
    </div>

  </div>
</section>

{% stylesheet %}

/* =========================================
   BASE SECTION
========================================= */
.shop-category-grid {
  background: #1c2b47;
  padding: 4rem 5rem;
  color: #fff;
}

.categories-heading {
  font-size: clamp(1.8rem, 3vw, 2.5rem);
  font-weight: 800;
  margin-bottom: 2.5rem;
  text-transform: uppercase;
  color: #ffffff;
}

/* GRID LAYOUT */
.categories-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.5rem;
}

/* CARD */
.category-card {
  display: block;
  text-decoration: none;
  color: inherit;
  position: relative;
  overflow: hidden;
  transition: transform .3s ease;
  border-radius: 14px;
}

.category-card:hover {
  transform: scale(1.03);
}

/* IMAGE */
.category-image {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1;
  background-size: cover;
  background-position: center;
  border-radius: 14px;
  overflow: hidden;
}

/* OVERLAY */
.category-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    rgba(0,0,0,0.40) 10%,
    rgba(0,0,0,0.15) 40%,
    transparent 100%
  );
  opacity: .5;
  transition: opacity .3s ease;
}

.category-card:hover .category-overlay {
  opacity: .9;
}

/* =========================================
   TITLE POSITION + ALIGN CONTROL
========================================= */

/* Content wrapper controls vertical placement */
.category-content {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  z-index: 3;
}

/* Vertical options */
.pos-top    { justify-content: flex-start; }
.pos-center { justify-content: center; }
.pos-bottom { justify-content: flex-end; }

/* TITLE */
.category-title {
  width: 100%;
  padding: 0.75rem 1rem;
  font-size: 1.8rem;
  font-family: "Bebas Neue";
  text-transform: uppercase;
  color: #fff;
  text-shadow: 0 3px 8px rgba(0,0,0,.55);
  background: linear-gradient(
    to top,
    rgba(0,0,0,0.65),
    rgba(0,0,0,0.15)
  );
}

/* Horizontal alignment */
.align-left { text-align: left;  }
.align-center { text-align: center; }
.align-right { text-align: right; }

/* =========================================
   RESPONSIVE
========================================= */

@media (max-width: 1200px) {
  .categories-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (max-width: 989px) {
  .categories-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

/* MOBILE — 1 per row */
@media (max-width: 600px) {
  .shop-category-grid {
    padding: 2.5rem 1.25rem;
    text-align: center;
  }

  .categories-grid {
    grid-template-columns: 1fr;
    gap: 1.2rem;
  }

  .category-title {
    font-size: 1.7rem;
    padding: 0.6rem 0.9rem;
  }
}

@media (max-width: 420px) {
  .category-title {
    font-size: 1.45rem;
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "Shop Category Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    }
  ],

  "blocks": [
    {
      "type": "category",
      "name": "Category Item",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Category Image" },
        { "type": "text", "id": "title", "label": "Category Title", "default": "Category" },
        { "type": "url", "id": "link", "label": "Category Link" },

        {
          "type": "select",
          "id": "text_position",
          "label": "Text Vertical Position",
          "default": "bottom",
          "options": [
            { "value": "top", "label": "Top" },
            { "value": "center", "label": "Center" },
            { "value": "bottom", "label": "Bottom" }
          ]
        },

        {
          "type": "select",
          "id": "text_alignment",
          "label": "Text Alignment",
          "default": "center",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ]
        }
      ]
    }
  ],

  "max_blocks": 8,

  "presets": [
    {
      "name": "Shop Category Grid",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
