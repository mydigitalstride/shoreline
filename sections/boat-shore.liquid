<section 
  class="from-boat-to-shore"
  {% if section.settings.background_image %}
    style="background-image: url('{{ section.settings.background_image | image_url: width: 2000 }}');"
  {% endif %}
>
  <div class="boat-wrapper">
    <div class="boat-text">
      <h2 class="boat-heading">{{ section.settings.heading }}</h2>
      <p class="boat-description">{{ section.settings.description }}</p>

      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link }}" class="boat-btn">
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>

    {% if section.settings.badge_image %}
      <div class="boat-badge">
        <img src="{{ section.settings.badge_image | image_url: width: 400 }}" alt="Badge">
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
/* === BASE SECTION === */
.from-boat-to-shore {
  position: relative;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  color: #1c2b47;
  padding: 6rem 2rem;
}

/* CONTENT BOX */
.boat-wrapper {
  max-width: 1200px;
  margin: 0 auto;
  background-color: #d2f3f4;
  padding: 4rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
  box-sizing: border-box;
}

/* TEXT AREA */
.boat-text {
  flex: 1;
  min-width: 300px;
}

.boat-heading {
  font-size: clamp(2rem, 4vw, 2.8rem);
  font-weight: 800;
  color: #1c2b47;
  margin-bottom: 1.5rem;
}

.boat-description {
  font-size: 1.05rem;
  line-height: 1.7;
  color: #1c2b47;
  margin-bottom: 2rem;
}

/* BUTTON */
.boat-btn {
  display: inline-block;
  background: #f15a29;
  color: #fff;
  font-weight: 800;
  text-transform: capitalize;
  padding: 1rem 2.5rem;
  text-decoration: none;
  font-size: 1.1rem;
  transition: background 0.3s ease;
}

.boat-btn:hover {
  background: #d94e21;
}

/* BADGE IMAGE */
.boat-badge {
  flex: 0 0 auto;
  display: flex;
  justify-content: flex-end;
  align-items: center;
}

.boat-badge img {
  max-width: 220px;
  height: auto;
}

/* =========================
   MOBILE FIX (Everything perfect)
========================= */
@media (max-width: 768px) {

  /* Light blue box */
  .boat-wrapper {
    width: 90%;           /* ensures even left/right margin */
    max-width: 600px;     /* makes layout stable */
    margin-left: auto;
    margin-right: auto;

    padding: 2rem 1.5rem;

    background-color: #d2f3f4;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;

    box-sizing: border-box;
    gap: 1.5rem;
  }

  /* Heading */
  .boat-heading {
    font-size: 1.7rem;
    line-height: 1.25;
    margin: 0 auto;
    width: 100%;
    max-width: 90%;
  }

  /* Description */
  .boat-description {
    font-size: 1.05rem;
    line-height: 1.6;
    width: 100%;
    max-width: 90%;
    margin: 0 auto 1.2rem auto; 
  }

  /* Button – smaller and centered */
  .boat-btn {
    display: block;
    width: 70%;              /* no more full width */
    max-width: 260px;        /* prevents overflowing */
    margin: 1rem auto 0 auto;
    padding: 0.9rem 1rem;

    font-size: 1rem;
    text-align: center;
  }

  /* Smaller badge */
  .boat-badge img {
    max-width: 100px;
  }
}

/* Super small screens */
@media (max-width: 480px) {

  .boat-wrapper {
    width: 92%;
    padding: 1.8rem 1.2rem;
  }

  .boat-heading {
    font-size: 1.55rem;
  }

  .boat-description {
    font-size: 0.95rem;
    max-width: 95%;
  }

  .boat-btn {
    width: 75%;
    max-width: 230px;
  }

  .boat-badge img {
    max-width: 90px;
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "Boat to Shore",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From Boat to Shore"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "From sun protection to performance gear, Shoreline products are built to help you enjoy every moment on the water. Don’t stop at apparel, check out our full range of shade extensions, accessories, and more."
    },
    {
      "type": "image_picker",
      "id": "badge_image",
      "label": "Badge Image (Right Side)"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop All Products"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Boat to Shore"
    }
  ]
}
{% endschema %}
