{% liquid
  assign media_count = 0
  if section.settings.image_1 != blank and section.settings.image_2 != blank
    assign media_width_desktop = 100 | divided_by: 2 | append: 'vw'
  else
    assign media_width_desktop = '100vw'
  endif
  assign media_width_mobile = '100vw'
  assign sizes = '(min-width: 750px) ' | append: media_width_desktop | append: ', ' | append: media_width_mobile
  assign widths = '832, 1200, 1600, 1920, 2560, 3840'

  assign has_image_1 = false
  assign has_video_1 = false
  assign has_image_2 = false
  assign has_video_2 = false

  assign media_type_1 = section.settings.media_type_1
  assign media_type_2 = section.settings.media_type_2

  if section.settings.image_1 != blank and media_type_1 == 'image'
    assign as_image_1 = true
  endif
  if section.settings.video_1 != blank and media_type_1 == 'video'
    assign has_video_1 = true
  endif
  if section.settings.image_2 != blank and media_type_2 == 'image'
    assign has_image_2 = true
  endif
  if section.settings.video_2 != blank and media_type_2 == 'video'
    assign has_video_2 = true
  endif

  assign has_media = false
  if has_image_1 or has_video_1 or has_image_2 or has_video_2
    assign has_media = true
  endif

  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
%}

{% capture media %}
  {% if has_image_1 %}
    {{ section.settings.image_1
      | image_url: width: 3840
      | image_tag:
        class: 'hero__image',
        sizes: sizes,
        widths: widths,
        fetchpriority: fetch_priority }}
  {% endif %}
  {% if has_video_1 %}
    {{ section.settings.video_1
      | video_tag: autoplay: true, loop: true, muted: true, controls: false, class: 'hero__video' }}
  {% endif %}
  {% if has_image_2 %}
    {{ section.settings.image_2
      | image_url: width: 3840
      | image_tag:
        class: 'hero__image',
        sizes: sizes,
        widths: widths,
        fetchpriority: fetch_priority }}
  {% endif %}
  {% if has_video_2 %}
    {{ section.settings.video_2
      | video_tag: autoplay: true, loop: true, muted: true, controls: false, class: 'hero__video' }}
  {% endif %}
  {% if has_media == false %}
    {{ 'hero-apparel-1' | placeholder_svg_tag: 'hero__image' }}
  {% endif %}
{% endcapture %}

<div id="Hero-{{ section.id }}" class="hero color-{{ section.settings.color_scheme }}">
   <div class="page-widthh">
  <div class="hero__media-wrapper">
    {{ media }}
  </div>

  <!-- PAGE WIDTH CONTAINER -->

    <div class="hero__content-wrapper">
      <div class="hero__logo-block">
        {% for block in section.blocks %}
          {% if block.type == 'logo' %}
            {% render block %}
          {% endif %}
        {% endfor %}
      </div>

      <div class="hero__text-block">
        {% for block in section.blocks %}
          {% unless block.type == 'logo' %}
            {% render block %}
          {% endunless %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
/* ---------- HERO BASE ---------- */
.hero {
  position: relative;
  overflow: hidden;
  min-height: var(--hero-min-height, 90vh);
}
/* ===== HERO UNDERLINE BELOW FIRST LINE (CLEAN, CENTERED, TAPERED) ===== */
.hero__text-block .text-block.h1 {
  display: inline-block;
  position: relative;
  padding-bottom: 0.25em; /* space between text and underline */
}

/* Line styling */
.hero__text-block .text-block.h1::after {
  content: "";
  position: absolute;
  left: 37%;
  bottom: 0;
  transform: translateX(-50%);
  width: 65%; /* shorten to fit text width */
  height: 5px; /* thinner line */
  
  background: linear-gradient(
    45deg,
    rgba(255,255,255,0.95) 0%,
    rgba(255,255,255,0.95) 10%,
    rgba(255,255,255,0.85) 70%,
    rgba(255,255,255,0) 100%
  );
  
  border-radius: 999px;
  clip-path: polygon(
    0 0,
    calc(100% - 12px) 0,
    100% 50%,
    calc(100% - 12px) 100%,
    0 100%
  );
}

/* Smaller + centered for mobile */
@media (max-width: 989px) {
  .hero__text-block .text-block.h1::after {
    width: 80%;
    height: 2px;
  }
}

.h1,
.h1.h1,
.text-block.h1 > * {
  font-family: "League Spartan";
  text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.8);
  font-weight: 700;
}

.hero__media-wrapper {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.hero__image,
.hero__video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Readability overlay */
.hero::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(rgba(44, 60, 94, 0.55), rgba(44, 60, 94, 0.25));
  z-index: 1;
}

.hero__content-wrapper {
  position: relative;
  z-index: 2;

  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;

  padding: 10vh 10vw !important;
  text-align: left;
}

.hero__logo-block {
  margin-bottom: 1rem;
}
.hero__text-block {
  max-width: 600px;
}

/* --- Buttons --- */
button,
.button,
.shopify-button {
  font-size: 16px !important;
  line-height: 1.2;
  padding: 12px 28px;
  border: 2px solid #f26522;
  background-color: #f26522;
  color: #fff;
  font-family: "League Spartan";
  transition: background-color 0.25s ease, color 0.25s ease;
  display: inline-block;
  margin-right: 1rem;
  text-transform: none !important;
}

button:hover,
.button:hover,
.shopify-button:hover {
  color: white;
  border-color: #f26522;
}

/* ---------- RESPONSIVE ---------- */

/* --- Tablet --- */
@media (max-width: 989px) {
  .hero {
    min-height: 75vh;
  }

  .hero__content-wrapper {
    padding: 6rem 2rem 3rem;
    align-items: center;
    text-align: center;
  }

  .hero__text-block {
    max-width: 90%;
  }

  button,
  .button,
  .shopify-button {
    margin: 0.5rem auto;
  }
}
/* Keep the first button orange */
.hero__text-block .button:first-of-type {
  background-color: #f26522;
  color: #fff;
  border: 3px solid #f26522;
}

/* Make the second button transparent with white border */
.hero__text-block .button:nth-of-type(2) {
  background-color: transparent;
  color: #fff;
  border: 3px solid #fff;
}

/* Hover effects */
.hero__text-block .button:first-of-type:hover {
  background-color: transparent;
  color: #f26522;
  border-color: #f26522;
}

.hero__text-block .button:nth-of-type(2):hover {
  background-color: #fff;
  color: #f26522;
}

/* --- Mobile --- */
@media (max-width: 749px) {
  .hero {
    min-height: 70vh;
  }

  .hero__content-wrapper {
    padding: 4rem 1.5rem 3rem;
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  .hero__logo-block {
    display: flex;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .hero__text-block {
    max-width: 95%;
  }

  .h1,
  .hero__text-block h1,
  .hero__text-block .h1 {
    font-size: clamp(1.8rem, 5vw, 2.2rem);
    line-height: 1.2;
  }

  .hero__text-block p {
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.9);
    margin-top: 0.75rem;
  }

  /* Fix buttons layout */
  .hero__text-block .button {
    display: block;
    width: 85%;
    max-width: 260px;
    padding: 0.9rem 1.2rem;
    font-size: 1rem !important;
    margin: 0.8rem auto;
    text-align: center;
  }

  /* Button 1 (orange) */
  .hero__text-block .button:nth-child(1) {
    background-color: #f26522;
    color: #fff;
    border-color: #f26522;
  }

  .hero__text-block .button:nth-child(1):hover {
    background-color: transparent;
    color: #f26522;
  }

  /* Button 2 (transparent with white border/text) */
  .hero__text-block .button:nth-child(2) {
    background-color: transparent;
    color: #ffffff;
    border-color: #ffffff;
  }

  .hero__text-block .button:nth-child(2):hover {
    background-color: #ffffff;
    color: #f26522;
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "t:names.hero",
  "tag": "section",
  "class": "hero-wrapper section-wrapper",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "text"
    },
    {
      "type": "button"
    },
    {
      "type": "logo"
    },
    {
      "type": "jumbo-text"
    },
    {
      "type": "spacer"
    },
    {
      "type": "group"
    },
    {
      "type": "_marquee"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.media"
    },
    {
      "type": "select",
      "id": "media_type_1",
      "label": "t:settings.type",
      "options": [
        {
          "value": "image",
          "label": "t:options.image"
        },
        {
          "value": "video",
          "label": "t:options.video"
        }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "t:settings.image",
      "visible_if": "{{ section.settings.media_type_1 == 'image' }}"
    },
    {
      "type": "video",
      "id": "video_1",
      "label": "t:settings.video",
      "visible_if": "{{ section.settings.media_type_1 == 'video' }}"
    },
    {
      "type": "header",
      "content": "t:content.media_2"
    },
    {
      "type": "select",
      "id": "media_type_2",
      "label": "t:settings.type",
      "options": [
        {
          "value": "image",
          "label": "t:options.image"
        },
        {
          "value": "video",
          "label": "t:options.video"
        }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "t:settings.image",
      "visible_if": "{{ section.settings.media_type_2 == 'image' }}"
    },
    {
      "type": "video",
      "id": "video_2",
      "label": "t:settings.video",
      "visible_if": "{{ section.settings.media_type_2 == 'video' }}"
    },
    {
      "type": "header",
      "content": "t:content.section_link"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "t:settings.open_new_tab",
      "default": false
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        },
        {
          "value": "row",
          "label": "t:options.horizontal"
        }
      ],
      "default": "column"
    },
    {
      "type": "checkbox",
      "id": "vertical_on_mobile",
      "label": "t:settings.vertical_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.content_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        },
        {
          "value": "space-between",
          "label": "t:options.space_between"
        }
      ],
      "default": "flex-start",
      "visible_if": "{{ section.settings.content_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "t:settings.position",
