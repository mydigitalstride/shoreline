    "faq_two_column_BJfKNF": {
      "type": "faq-two-column",
      "blocks": {
        "faq_iXiyVY": {
          "type": "faq",
          "settings": {
            "question": "What Bimini Shade Extension will fit my boat?",
            "answer": "<p>We have over 18 different variations of shade extensions to fit most makes and models. Use our search tool to find yours. If you still cannot locate the correct kit please reach out for team member assistance.</p>"
          }
        },
        "faq_xWkV6i": {
          "type": "faq",
          "settings": {
            "question": "What if I have an existing bimini top?",
            "answer": "<p>Our versatile boat shade kits are designed to be used in addition to your factory Bimini tops. We intentionally provide telescopic poles that are longer than the sunshade provided to eliminate any overlap between your factory bimini and our bimini extension kit.</p>"
          }
        },
        "faq_nFNXME": {
          "type": "faq",
          "settings": {
            "question": "What if I don't have a wakeboard tower?",
            "answer": "<p>We offer shade kits for virtually all makes and models. Visit our shade solutions page to learn more about our products.</p>"
          }
        },
        "faq_qzwPmL": {
          "type": "faq",
          "settings": {
            "question": "How do you store the bimini shade extension when it is not extended?",
            "answer": "<p>The included mounting brackets will always remain on the tower. When not in use, the poles collapse down to 36\" long and can be easily stored in one of your boat compartments. The shade material is also light and flexible for easy storage anywhere on your boat. We also offer an optional storage and carrying case to accompany your sunshade kit.</p>"
          }
        },
        "faq_PqHDDr": {
          "type": "faq",
          "settings": {
            "question": "How long does it take to set up the bimini shade extension?",
            "answer": "<p>Setting up the shade is a breeze. With the included mounting hardware, you can complete the initial setup in just 5-10 minutes. Once in position, deploying or disassembling the shade and telescoping poles takes less than a minute.</p>"
          }
        },
        "faq_fE6GKa": {
          "type": "faq",
          "settings": {
            "question": "Can I use the bimini shade extension while wakesurfing?",
            "answer": "<p>Yes, the product can be used while surfing. The rope will be passed underneath to attach to your tow point. The maximum recommended speed is 15mph.</p>"
          }
        },
        "faq_nq7mK7": {
          "type": "faq",
          "settings": {
            "question": "Do you offer custom colors for the bimini extension?",
            "answer": "<p>We keep a black color shade in stock; customization is available for an additional fee. Please use the contact us form for general inquiries.</p>"
          }
        },
        "faq_WMztjH": {
          "type": "faq",
          "settings": {
            "question": "What is a Bimini Extension?",
            "answer": "<p>A Bimini Extension is a sun shade device used on your boat to provide protection to passengers not covered by your factory Bimini. \n\nAlso Known As: Shade Sail, Boat Shade Extension, Transom Awning, Wake Shade, Sun Shade Canopy</p>"
          }
        }
      },
