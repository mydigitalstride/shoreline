    "our_story_section_Hfk7my": {
      "type": "our-story-section",
      "name": "Our Story Section",
      "settings": {
        "right_image": "shopify://shop_images/IMG_2346.jpg",
        "heading": "warranty policy",
        "text": "<p>We stand behind the quality of our products. Enjoy peace of mind with a 1-year warranty that covers manufacturing defects and damage from regular use. </p><p>Please inspect your purchase upon arrival before using or installing it. If you encounter further issues after the warranty has expired, we are happy to provide replacement components at a reduced price. </p><p>To validate your warranty claim, kindly provide photographic evidence of the defect. The warranty can only be processed by the original purchaser and does not apply to second-hand purchases.</p>"
      }
    },
