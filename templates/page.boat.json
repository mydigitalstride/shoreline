      </video>\n      <button class=\"mute-toggle\" onclick=\"toggleMute(this.previousElementSibling)\">Tap for Sound</button>\n      <div class=\"video-overlay\">PONTOON BOAT PARTY!</div>\n\n\n    </div>\n    <div class=\"mobile-card video-card\">\n      <video playsinline muted loop autoplay preload=\"metadata\" onclick=\"toggleMute(this)\">\n        <source src=\"https://shorelinebrands.com/cdn/shop/videos/c/vp/d1db59523ee34ad3a92c6e74d0358922/d1db59523ee34ad3a92c6e74d0358922.HD-1080p-7.2Mbps-84988507.mp4?v=0\">\n      </video>\n      <button class=\"mute-toggle\" onclick=\"toggleMute(this.previousElementSibling)\">Tap for Sound</button>\n      <div class=\"video-overlay\">Fast to Set Up!</div>\n\n\n    </div>\n  </div>\n</div>\n  \n<script>\n  function toggleMute(video) {\n    video.muted = !video.muted;\n    const btn = video.nextElementSibling;\n    if (video.muted) {\n      btn.innerHTML = \"Tap for Sound\";\n      btn.style.opacity = \"1\";\n    } else {\n      btn.innerHTML = \"Mute\";\n      btn.style.opacity = \"0.5\";\n    }\n  }\n</script>\n  \n<style>\n  /* Container Setup */\n  .scrolling-testimonial-wrapper {\n    width: 100vw !important; \n    position: relative !important;\n    left: 50% !important;\n    right: 50% !important;\n    margin-left: -50vw !important;\n    margin-right: -50vw !important;\n    padding: 40px 20px !important;\n    background: #2c3c5e !important; /* Solid blue background */\n    overflow: hidden;\n  }\n  \n  .testimonial-scroll-container {\n    display: flex;\n    gap: 15px;\n    overflow-x: auto;\n    scroll-snap-type: x mandatory;\n    padding-bottom: 20px;\n    -webkit-overflow-scrolling: touch;\n    max-width: 1400px; \n    margin: 0 auto; \n  }\n  \n  .testimonial-scroll-container::-webkit-scrollbar {\n    display: none;\n  }\n  \n  /* Kill the Theme's White Card Styles */\n  .mobile-card {\n    flex: 0 0 280px !important;\n    height: 500px !important;\n    background: transparent !important; \n    border-radius: 16px !important;\n    overflow: hidden !important;\n    position: relative !important;\n    scroll-snap-align: start !important;\n    box-shadow: none !important; /* Removes default shadow */\n    padding: 0 !important; /* Forces the video to the edges */\n    border: none !important; /* Removes any white border */\n    margin: 0 !important;\n  }\n  \n  /* Force Video to Fill Completely */\n  .video-card video {\n    position: absolute !important;\n    top: 0 !important;\n    left: 0 !important;\n    width: 100% !important;\n    height: 100% !important;\n    object-fit: cover !important;\n    background: transparent !important; \n    cursor: pointer !important;\n    padding: 0 !important;\n    margin: 0 !important;\n    border-radius: 16px !important;\n    display: block !important;\n  }\n  \n  /* Mute Button Overlay */\n  .mute-toggle {\n    position: absolute;\n    top: 15px;\n    right: 15px;\n    background: rgba(0,0,0,0.6);\n    color: white;\n    border: none;\n    padding: 5px 10px;\n    border-radius: 20px;\n    font-size: 10px;\n    text-transform: uppercase;\n    cursor: pointer;\n    z-index: 10;\n    transition: opacity 0.3s;\n  }\n  \n  .video-overlay {\n    position: absolute;\n    bottom: 40px;\n    left: 0;\n    right: 0;\n    color: white;\n    text-align: center;\n    font-weight: 800;\n    font-size: 1.2rem;\n    text-transform: uppercase;\n    text-shadow: 0 2px 10px rgba(0,0,0,0.8); /* Darkened shadow so text pops more */\n    pointer-events: none;\n    padding: 0 10px;\n    z-index: 5;\n  }\n  \n  @media (max-width: 480px) {\n    .mobile-card {\n      flex: 0 0 250px !important;\n      height: 450px !important;\n    }\n  }\n</style>",
