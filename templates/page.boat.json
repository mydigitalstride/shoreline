    "faq_two_column_aE39j6": {
      "type": "faq-two-column",
      "blocks": {
        "faq_BQyyL8": {
          "type": "faq",
          "settings": {
            "question": "What Bimini Shade Extension will fit my boat?",
            "answer": "<p>We have over 18 different variations of shade extensions to fit most makes and models. Use our search tool to find yours. If you still cannot locate the correct kit, please reach out for team member assistance. </p><p>Find what you're looking for <a href=\"/pages/shade-solutions\" title=\"Shade Solutions\">here</a></p>"
          }
        },
        "faq_9qR83R": {
          "type": "faq",
          "settings": {
            "question": "Can I use my bimini extension while driving?",
            "answer": "<p>Yes. Shoreline Brands Bimini Extensions are rated for use at speeds up to <strong>15 mph</strong>. This rating accounts for typical wind and weather conditions you may encounter on the lake.</p><p>In calm conditions, many customers find they can operate at slightly higher speeds. That said, conditions vary, so we always recommend using good judgment and reducing speed if winds pick up or water conditions change.</p>"
          }
        },
        "faq_mJNgJd": {
          "type": "faq",
          "settings": {
            "question": "Can I use my bimini extension while wakesurfing and wakeboarding?",
            "answer": "<p>Yes, our bimini extension products can be used while wakesurfing. Simply pass your rope beneath the shade</p><p>We recommend taking the shade system down while wakeboarding or waterskiing.</p>"
          }
        },
        "faq_qeweKR": {
          "type": "faq",
          "settings": {
            "question": "What if I have an existing bimini top?",
            "answer": "<p>Our versatile boat shade kits are designed to be used in addition to your factory Bimini tops. We intentionally provide telescopic poles that are longer than the sunshade provided to eliminate any overlap between your factory bimini and our bimini extension kit.</p>"
          }
        },
        "faq_JnCQLw": {
          "type": "faq",
          "settings": {
            "question": "What if I don't have a wakeboard tower?",
            "answer": "<p>We offer shade kits for virtually all makes and models. Visit our shade solutions page to learn more about our products.</p>"
          }
        },
        "faq_ccNFcG": {
          "type": "faq",
          "settings": {
            "question": "How do you store the bimini shade extension when it is not extended?",
            "answer": "<p>The included mounting brackets will always remain on the tower. When not in use, the poles collapse down to 36\" and the shade folds up neatly. Both can be stored in the provided storage bag</p>"
          }
        },
        "faq_YHmLYd": {
          "type": "faq",
          "settings": {
            "question": "How long does it take to set up the bimini shade extension?",
            "answer": "<p>Setting up the shade is a breeze. With the included mounting hardware, you can complete the initial setup in 10 minutes. Once in position, deploying or disassembling the shade and telescoping poles takes less than a minute.</p>"
          }
        },
        "faq_KKc8cG": {
          "type": "faq",
          "settings": {
            "question": "Do you offer custom colors for the bimini extension?",
            "answer": "<p>We keep a black color shade in stock; customization is available for an additional fee. Please use the contact us form for general inquiry</p>"
