    "mission_vision_goal_id9cDq": {
      "type": "mission-vision-goal",
      "blocks": {
        "item_7werdg": {
          "type": "item",
          "settings": {
            "icon": "shopify://shop_images/Assets_70f5a8e4-c2b9-498d-8a8e-7d16a20a0940.png",
            "title": "Mission",
            "text": "At Shoreline Brands, our mission is to enhance your time on the water by providing high-quality, affordable products designed for comfort, convenience, and durability. We’re passionate about helping boaters extend their adventures and enjoy every moment spent with family and friends."
          }
        },
        "item_6TwRzC": {
          "type": "item",
          "settings": {
            "icon": "shopify://shop_images/Assets_70f5a8e4-c2b9-498d-8a8e-7d16a20a0940.png",
            "title": "Vision",
            "text": "Our vision is to make Shoreline Brands the most trusted name in boating innovation, offering reliable, easy-to-use solutions that allow boating enthusiasts to make the most of their time on the water."
          }
        },
        "item_Lm7NUD": {
          "type": "item",
          "settings": {
            "icon": "shopify://shop_images/Assets_70f5a8e4-c2b9-498d-8a8e-7d16a20a0940.png",
            "title": "Goal",
            "text": "We aim for 100% customer satisfaction through exceptional service, craftsmanship, and product performance. By continually improving our bimini extension designs and other marine accessories, we’re dedicated to exceeding expectations and building long-term relationships with our customers."
