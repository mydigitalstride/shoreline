      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<style>\n  .custom-video-banner {\n    position: relative;\n    width: 100%;\n    height: 650px;\n    overflow: hidden;\n    background: #000;\n  }\n\n.custom-video-banner__text a {\n  color: #fff; /* Keeps the link white */\n  text-decoration: underline; /* Optional: keeps the underline so people know to click it */\n}\n\n.custom-video-banner__text a:hover {\n  color: #f15a29; /* Optional: changes to your brand orange when they hover over it */\n}\n\n  .custom-video-banner video {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n  }\n\n  /* Added a dark overlay to make white text pop more */\n  .custom-video-banner::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background: rgba(0, 0, 0, 0.2);\n    z-index: 1;\n  }\n\n  .custom-video-banner__overlay {\n    position: absolute;\n    inset: 0;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n    z-index: 2;\n    padding: 20px;\n  }\n\n  .custom-video-banner__content {\n    max-width: 900px;\n    color: #fff;\n    /* Subtle shadow for maximum readability over moving water */\n    text-shadow: 0 4px 15px rgba(0,0,0,0.4);\n  }\n\n  .custom-video-banner__title {\n    margin: 0 0 10px;\n    font-size: 80px; /* Big heading */\n    line-height: 1.1;\n    font-weight: 800;\n    text-transform: uppercase;\ncolor: #fff;\n  }\n\n  .custom-video-banner__text {\n    margin: 0;\n    font-size: 24px;\n    line-height: 1.5;\n    font-weight: 400;\n    letter-spacing: 0.05em;\n  }\n\n  @media screen and (max-width: 749px) {\n    .custom-video-banner {\n      height: 420px;\n    }\n\n    .custom-video-banner__title {\n      font-size: 42px; /* Scale down for mobile */\n    }\n\n    .custom-video-banner__text {\n      font-size: 18px;\n    }\n  }\n</style>\n\n<div class=\"custom-video-banner\">\n  <video autoplay muted loop playsinline preload=\"auto\">\n    <source src=\"https://shorelinebrands.com/cdn/shop/videos/c/vp/8872484450c046fe91080cee6d247d16/8872484450c046fe91080cee6d247d16.HD-1080p-4.8Mbps-84925515.mp4?v=0\">\n  </video>\n\n  <div class=\"custom-video-banner__overlay\">\n    <div class=\"custom-video-banner__content\">\n      <h2 class=\"custom-video-banner__title\">Frustration-free.</h2>\n      <p class=\"custom-video-banner__text\">\n  <a href=\"https://shorelinebrands.com/pages/warranty\">Peace of Mind Warranty</a>\n</p>\n    </div>\n  </div>\n</div>",
