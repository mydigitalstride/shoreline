    "custom_liquid_Jdi9ap": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<div class=\"scrolling-testimonial-wrapper\">\n    <div class=\"testimonial-scroll-container\">\n      \n      <div class=\"mobile-card video-card\">\n        <video playsinline muted loop autoplay preload=\"metadata\" onclick=\"toggleMute(this)\">\n          <source src=\"https://shorelinebrands.com/cdn/shop/videos/c/vp/3bfc6def4e5e4d2a8fdda09481dc5182/3bfc6def4e5e4d2a8fdda09481dc5182.HD-1080p-7.2Mbps-84909560.mp4?v=0\">\n        </video>\n        <button class=\"mute-toggle\" onclick=\"toggleMute(this.previousElementSibling)\">Tap for Sound</button>\n        <div class=\"video-overlay\">EASY TO INSTALL!!!</div>\n      </div>\n\n      <div class=\"mobile-card video-card\">\n        <video playsinline muted loop autoplay preload=\"metadata\" onclick=\"toggleMute(this)\">\n          <source src=\"https://shorelinebrands.com/cdn/shop/videos/c/vp/f9617a1550e849dbb7a90c82c1282bc3/f9617a1550e849dbb7a90c82c1282bc3.HD-1080p-7.2Mbps-84909559.mp4?v=0\">\n        </video>\n        <button class=\"mute-toggle\" onclick=\"toggleMute(this.previousElementSibling)\">Tap for Sound</button>\n        <div class=\"video-overlay\">GOES UP IN 60 SECONDS!</div>\n      </div>\n  \n      <div class=\"mobile-card video-card\">\n        <video playsinline muted loop autoplay preload=\"metadata\" onclick=\"toggleMute(this)\">\n          <source src=\"https://shorelinebrands.com/cdn/shop/videos/c/vp/167a4c79a15a4f32b21c5abe36be1d60/167a4c79a15a4f32b21c5abe36be1d60.HD-720p-1.6Mbps-84909883.mp4?v=0\">\n        </video>\n        <button class=\"mute-toggle\" onclick=\"toggleMute(this.previousElementSibling)\">Tap for Sound</button>\n        <div class=\"video-overlay\">MUST HAVE!!</div>\n      </div>\n  \n  \n      <div class=\"mobile-card video-card\">\n        <video playsinline muted loop autoplay preload=\"metadata\" onclick=\"toggleMute(this)\">\n          <source src=\"https://shorelinebrands.com/cdn/shop/videos/c/vp/71933d7ec0cc41f588a9291ee2e3b484/71933d7ec0cc41f588a9291ee2e3b484.HD-1080p-7.2Mbps-84910251.mp4?v=0\">\n        </video>\n        <button class=\"mute-toggle\" onclick=\"toggleMute(this.previousElementSibling)\">Tap for Sound</button>\n        <div class=\"video-overlay\">PONTOON BOAT PARTY!</div>\n      </div>\n\n\n  \n    </div>\n  </div>\n  \n  <script>\n    function toggleMute(video) {\n      video.muted = !video.muted;\n      const btn = video.nextElementSibling;\n      if (video.muted) {\n        btn.innerHTML = \"Tap for Sound\";\n        btn.style.opacity = \"1\";\n      } else {\n        btn.innerHTML = \"Mute\";\n        btn.style.opacity = \"0.5\";\n      }\n    }\n  </script>\n  \n  <style>\n    /* Container Setup */\n    .scrolling-testimonial-wrapper {\n      width: 100%;\n      padding: 40px 20px;\n      background: #fffff;\n      overflow: hidden;\n    }\n  \n    .testimonial-scroll-container {\n      display: flex;\n      gap: 15px;\n      overflow-x: auto;\n      scroll-snap-type: x mandatory;\n      padding-bottom: 20px;\n      -webkit-overflow-scrolling: touch;\n    }\n  \n    .testimonial-scroll-container::-webkit-scrollbar {\n      display: none;\n    }\n  \n    .mobile-card {\n      flex: 0 0 280px;\n      height: 500px;\n      background: white;\n      border-radius: 16px;\n      overflow: hidden;\n      position: relative;\n      scroll-snap-align: start;\n      box-shadow: 0 10px 20px rgba(0,0,0,0.08);\n    }\n  \n    .text-card {\n      display: flex;\n      flex-direction: column;\n      padding: 30px 20px;\n      justify-content: space-between;\n      text-align: center;\n    }\n  \n    .stars { color: #e7e668; font-size: 20px; margin-bottom: 10px; }\n    .text-card h3 { font-size: 1.1rem; margin-bottom: 15px; line-height: 1.3; }\n    .text-card p { font-size: 0.9rem; color: #444; line-height: 1.6; }\n    \n    .footer-logo { width: 40px; margin: 0 auto 5px; filter: grayscale(1); }\n    .author { font-weight: bold; font-size: 0.8rem; }\n  \n    .video-card video {\n      width: 100%;\n      height: 100%;\n      object-fit: cover;\n      background: #000;\n      cursor: pointer;\n    }\n  \n    /* Mute Button Overlay */\n    .mute-toggle {\n      position: absolute;\n      top: 15px;\n      right: 15px;\n      background: rgba(0,0,0,0.6);\n      color: white;\n      border: none;\n      padding: 5px 10px;\n      border-radius: 20px;\n      font-size: 10px;\n      text-transform: uppercase;\n      cursor: pointer;\n      z-index: 10;\n      transition: opacity 0.3s;\n    }\n  \n    .video-overlay {\n      position: absolute;\n      bottom: 40px;\n      left: 0;\n      right: 0;\n      color: white;\n      text-align: center;\n      font-weight: 800;\n      font-size: 1.2rem;\n      text-transform: uppercase;\n      text-shadow: 0 2px 10px rgba(0,0,0,0.5);\n      pointer-events: none;\n      padding: 0 10px;\n    }\n  \n    @media (max-width: 480px) {\n      .mobile-card {\n        flex: 0 0 250px;\n        height: 450px;\n      }\n    }\n  </style>",
