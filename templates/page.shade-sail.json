    "custom_liquid_HyTXhU": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<div class=\"scrolling-testimonial-wrapper\">\n  <div class=\"testimonial-scroll-container\">\n    \n    <!-- Review 1: Bob Beresh -->\n    <div class=\"mobile-card text-card\">\n      <div class=\"stars\">★★★★★</div>\n      <div class=\"card-content\">\n        <h3 class=\"testimony-title\">\"Best in the game\"</h3>\n        <p class=\"testimony-text\">We truly believe Shoreline’s Bimini Shade Extension is the best in the game. We’ve had one installed on every boat we’ve owned, and we honestly can’t imagine a day on the water without it. This is a must-have accessory.</p>\n      </div>\n      <div class=\"card-footer\">\n        <img src=\"https://scontent-mia5-1.xx.fbcdn.net/v/t39.30808-6/547684915_1540939653731923_3603897006261598258_n.jpg?_nc_cat=104&ccb=1-7&_nc_sid=6ee11a&_nc_ohc=r5mkSvNaotYQ7kNvwGMa7DP&_nc_oc=AdqF4YzvnAwL8Cs4Mk7XMcNvN-oKqCpXBMswR4bDqruiA2F7XwAcVdeXWj43uLJ_XYk&_nc_zt=23&_nc_ht=scontent-mia5-1.xx&_nc_gid=RewKW6ihcyRibbPclbgYfw&_nc_ss=7b2a8&oh=00_Af4Kcz_EH4fdlXLAtFddmjiPzZZDrYXe1pr96jnDtDXRLA&oe=6A1A8C7B\" class=\"author-img\" alt=\"Bob Beresh\">\n        <div class=\"author-info\">\n          <p class=\"author\">Bob Beresh</p>\n          <p class=\"meta\">Arizona</p>\n        </div>\n      </div>\n    </div>\n\n    <!-- Review 2: Matthew Paul Vara -->\n    <div class=\"mobile-card text-card\">\n      <div class=\"stars\">★★★★★</div>\n      <div class=\"card-content\">\n        <h3 class=\"testimony-title\">\"Summer took a turn for the better\"</h3>\n        <p class=\"testimony-text\">Got one of these shades for my Nautique G23. We love it, quality product. Carbon fiber is dialed looking. Installation is super easy, even on a wavy lake me and a buddy were able to get it installed in just a few minutes.</p>\n      </div>\n      <div class=\"card-footer\">\n        <img src=\"https://scontent-mia5-1.xx.fbcdn.net/v/t39.30808-1/301908151_10221597381140737_6909609064185544049_n.jpg?stp=c528.368.329.329a_dst-jpg_s329x329_tt6&_nc_cat=104&ccb=1-7&_nc_sid=e99d92&_nc_ohc=GEEPdon_-F0Q7kNvwGX2qCX&_nc_oc=AdqY7ySszfu6rSPYpZ1ePneyDm8N6YrOCTKe1Y4SSlI_3IWEm31ye3v4vXXG0n4Bcgc&_nc_zt=24&_nc_ht=scontent-mia5-1.xx&_nc_gid=V9_W3hlfJ-2EiWYzX30sJA&_nc_ss=7b2a8&oh=00_Af6j4bi6zwhNbIz7gafbgbCU1Bb8xgsdHC_efoYfC3Qq0Q&oe=6A1A91FF\" class=\"author-img\" alt=\"Matthew Paul Vara\">\n        <div class=\"author-info\">\n          <p class=\"author\">Matthew Paul Vara</p>\n          <p class=\"meta\">Texas</p>\n        </div>\n      </div>\n    </div>\n\n    <!-- Review 3: Tyler Wells -->\n    <div class=\"mobile-card text-card\">\n      <div class=\"stars\">★★★★★</div>\n      <div class=\"card-content\">\n        <h3 class=\"testimony-title\">\"Setup takes 30 seconds\"</h3>\n        <p class=\"testimony-text\">This product is great but the customer service is next level! I sent in an email and instead of getting an email back in a few days I immediately got a text. Setup takes maybe 30 seconds... Great product better people!</p>\n      </div>\n      <div class=\"card-footer\">\n        <img src=\"https://scontent-mia5-2.xx.fbcdn.net/v/t39.30808-1/316319639_10106549230556467_8398178399303896253_n.jpg?stp=dst-jpg_s480x480_tt6&_nc_cat=100&ccb=1-7&_nc_sid=e99d92&_nc_ohc=WubD3AOtqAwQ7kNvwHjIhQh&_nc_oc=Adob5TEseIfLso3M_6oYfPFn9_Mhm6CvqBkTjeACUvTAw6C2HgdlDn_z9XLjj5wqc5g&_nc_zt=24&_nc_ht=scontent-mia5-2.xx&_nc_gid=e8RvJ8EtAsEf3P6YKPLhww&_nc_ss=7b2a8&oh=00_Af6cI85bZhmxYCRZEv0LDCvXRK8lK0tupabDguA1oOp7SQ&oe=6A1A87AC\" class=\"author-img\" alt=\"Tyler Wells\">\n        <div class=\"author-info\">\n          <p class=\"author\">Tyler Wells</p>\n          <p class=\"meta\">Arkansas</p>\n        </div>\n      </div>\n    </div>\n\n    <!-- Review 4: Michael Costa -->\n    <div class=\"mobile-card text-card\">\n      <div class=\"stars\">★★★★★</div>\n      <div class=\"card-content\">\n        <h3 class=\"testimony-title\">\"Best online purchase\"</h3>\n        <p class=\"testimony-text\">Fits great and can’t say enough about the customer service. Kevin was great and provided two different size shades for me to try and different mounting hardware at no additional cost. Hands down the best online purchase!</p>\n      </div>\n      <div class=\"card-footer\">\n        <img src=\"https://scontent-mia3-1.xx.fbcdn.net/v/t39.30808-1/458697277_8280863271952879_2095773134258637553_n.jpg?stp=cp6_dst-jpg_s480x480_tt6&_nc_cat=111&ccb=1-7&_nc_sid=e99d92&_nc_ohc=nvpv17GJkEgQ7kNvwEdxvnL&_nc_oc=AdrR43dkQh1_Cl0pJa2l66-9wO1cQ2aKUN_aX31W5LtXXwULe8qv_GWakLokqCi8iG4&_nc_zt=24&_nc_ht=scontent-mia3-1.xx&_nc_gid=Pwc4bwx_MoLq6tL4b0Cx9A&_nc_ss=7b2a8&oh=00_Af5SZiUI1TpsV6MJwFKUuOXg4N-gZ6_8fP9OEDptMXPgSg&oe=6A1A80D6\"class=\"author-img\" alt=\"Michael Costa\">\n        <div class=\"author-info\">\n          <p class=\"author\">Michael Costa</p>\n          <p class=\"meta\">Massachusetts</p>\n        </div>\n      </div>\n    </div>\n\n    <!-- Review 5: Nicklas Frölander -->\n    <div class=\"mobile-card text-card\">\n      <div class=\"stars\">★★★★★</div>\n      <div class=\"card-content\">\n        <h3 class=\"testimony-title\">\"Loyalty for life\"</h3>\n        <p class=\"testimony-text\">I noticed they’d upgraded their attachments. I contacted them to buy the new set, and Kevin responded saying they value their early customers and would send me the updated attachments at no cost. That’s top-notch service!</p>\n      </div>\n      <div class=\"card-footer\">\n        <img src=\"https://scontent-mia5-1.xx.fbcdn.net/v/t39.30808-1/484950486_10160755254005925_2242083518139167746_n.jpg?stp=dst-jpg_s480x480_tt6&_nc_cat=104&ccb=1-7&_nc_sid=1d2534&_nc_ohc=sD_DAcv_HKIQ7kNvwHGdE8b&_nc_oc=AdoOCh9ePJh_jt-wER0Jp0trK5ScIqcZ7bpgvhddl_mApUiRf8PRLM1_BZh088ZurQU&_nc_zt=24&_nc_ht=scontent-mia5-1.xx&_nc_gid=vowww7xLWIsVvBzUECBWYw&_nc_ss=7b2a8&oh=00_Af4IwiU-LMPqksp6MWynbER2wA-P8h_yVtBH5a3EVoklHw&oe=6A1A9B01\" class=\"author-img\" alt=\"Nicklas Frölander\">\n        <div class=\"author-info\">\n          <p class=\"author\">Nicklas Frölander</p>\n          <p class=\"meta\">Minnesota</p>\n        </div>\n      </div>\n    </div>\n\n  </div>\n</div>\n\n<style>\n  .scrolling-testimonial-wrapper {\n    width: 100%;\n    padding: 40px 15px;\n    background: #f9f9f9;\n    overflow: hidden;\n  }\n\n  .testimonial-scroll-container {\n    display: flex;\n    gap: 15px;\n    overflow-x: auto;\n    scroll-snap-type: x mandatory;\n    padding: 10px 10px 30px;\n    -webkit-overflow-scrolling: touch;\n  }\n\n  .testimonial-scroll-container::-webkit-scrollbar { \n    display: none; \n  }\n\n  .mobile-card {\n    flex: 0 0 300px;\n    height: auto; \n    min-height: 400px; \n    background: #ffffff !important;\n    border-radius: 20px;\n    display: flex;\n    flex-direction: column;\n    padding: 25px;\n    scroll-snap-align: center;\n    box-shadow: 0 8px 24px rgba(0,0,0,0.06);\n    justify-content: space-between;\n  }\n\n  .mobile-card .stars { \n  color: #FFD700 !important;\n  font-size: 28px !important; \n  margin: 0 auto 5px auto !important; \n  letter-spacing: 0;\n  line-height: 1;\n  text-align: center !important; \n  width: 100%;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n}\n\n  /* Added highly specific classes to override theme settings */\n  h3.testimony-title { \n    font-size: 1.4rem !important; \n    font-weight: 800 !important; \n    margin: 5px 0 10px 0 !important; \n    color: #000000 !important; \n    line-height: 1.2 !important;\n  }\n\n  p.testimony-text { \n    font-size: 1.05rem !important; \n    color: #333333 !important; \n    line-height: 1.5 !important; \n    font-weight: 500 !important; \n    margin: 0 !important;\n  }\n\n  .card-footer {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    padding-top: 20px;\n    margin-top: 20px;\n    border-top: 1px solid #eaeaea;\n  }\n\n  .author-img {\n    width: 50px; \n    height: 50px;\n    border-radius: 50%;\n    object-fit: cover;\n    background: #eee;\n  }\n\n  .author-info {\n    display: flex;\n    flex-direction: column;\n    gap: 2px;\n  }\n\n  p.author { \n    font-weight: 800 !important; \n    font-size: 1.1rem !important; \n    margin: 0 !important;\n    color: #000000 !important; \n    line-height: 1 !important;\n  }\n\n  p.meta { \n    font-size: 0.9rem !important; \n    color: #666666 !important; \n    margin: 0 !important; \n    font-weight: 600 !important;\n  }\n\n  @media (max-width: 480px) {\n    .mobile-card {\n      flex: 0 0 285px;\n      padding: 22px;\n    }\n    h3.testimony-title {\n      font-size: 1.25rem !important;\n    }\n    p.testimony-text {\n      font-size: 1rem !important;\n    }\n    .stars {\n      font-size: 24px !important;\n    }\n    p.author {\n      font-size: 1rem !important;\n    }\n  }\n</style>",
