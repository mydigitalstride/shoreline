    "custom_liquid_3dDcYA": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<div class=\"centered-video-section\">\n  <div class=\"video-card-centered\">\n    <video playsinline muted loop autoplay preload=\"metadata\" onclick=\"toggleMute(this)\">\n      <source src=\"https://nothrowss.com/cdn/shop/videos/c/vp/491253e944b24786a13c9a04ff8d5d71/491253e944b24786a13c9a04ff8d5d71.HD-1080p-4.8Mbps-82444941.mp4?v=0\" type=\"video/mp4\">\n    </video>\n    <button class=\"mute-toggle\" onclick=\"toggleMute(this.previousElementSibling)\">Tap for Sound</button>\n    <div class=\"video-overlay\">EASY TO Use!!!</div>\n  </div>\n</div>\n\n<script>\n  function toggleMute(video) {\n    video.muted = !video.muted;\n    const btn = video.nextElementSibling;\n    if (video.muted) {\n      btn.innerHTML = \"Tap for Sound\";\n      btn.style.opacity = \"1\";\n    } else {\n      btn.innerHTML = \"Mute\";\n      btn.style.opacity = \"0.5\";\n    }\n  }\n</script>\n\n<style>\n  /* Centering Wrapper */\n  .centered-video-section {\n    width: 100%;\n    padding: 60px 20px;\n    background: #f9f9f9;\n    display: flex;\n    justify-content: center; /* Centers horizontally */\n    align-items: center;\n  }\n\n  /* Video Card Styling */\n  .video-card-centered {\n    width: 320px; /* Width on desktop */\n    height: 570px; /* Maintains 9:16 vertical ratio */\n    background: #000;\n    border-radius: 20px;\n    overflow: hidden;\n    position: relative;\n    box-shadow: 0 15px 35px rgba(0,0,0,0.15);\n  }\n\n  .video-card-centered video {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    cursor: pointer;\n    display: block;\n  }\n\n  /* Mute Button Overlay */\n  .mute-toggle {\n    position: absolute;\n    top: 20px;\n    right: 20px;\n    background: rgba(0,0,0,0.6);\n    color: white;\n    border: none;\n    padding: 6px 12px;\n    border-radius: 20px;\n    font-size: 11px;\n    font-weight: 700;\n    text-transform: uppercase;\n    cursor: pointer;\n    z-index: 10;\n    transition: opacity 0.3s;\n  }\n\n  /* Text Overla