        "custom_liquid": "<div class=\"centered-video-section\">\n  <div class=\"video-card-centered\">\n    <video playsinline muted loop autoplay preload=\"metadata\" onclick=\"toggleMute(this)\">\n      <source src=\"https://shorelinebrands.com/cdn/shop/videos/c/vp/7d1e68e433d54b69b229b0d9f9ed8039/7d1e68e433d54b69b229b0d9f9ed8039.HD-1080p-3.3Mbps-84911631.mp4?v=0\">\n    </video>\n    <button class=\"mute-toggle\" onclick=\"toggleMute(this.previousElementSibling)\">Tap for Sound</button>\n    <div class=\"video-overlay\"></div>\n  </div>\n</div>\n\n<script>\n  function toggleMute(video) {\n    video.muted = !video.muted;\n    const btn = video.nextElementSibling;\n    if (video.muted) {\n      btn.innerHTML = \"Tap for Sound\";\n      btn.style.opacity = \"1\";\n    } else {\n      btn.innerHTML = \"Mute\";\n      btn.style.opacity = \"0.5\";\n    }\n  }\n</script>\n\n<style>\n  /* Centering Wrapper */\n  .centered-video-section {\n    width: 100%;\n    padding: 60px 20px;\n    background: #ffff;\n    display: flex;\n    justify-content: center; /* Centers horizontally */\n    align-items: center;\n  }\n\n  /* Video Card Styling (Updated for Horizontal) */\n  .video-card-centered {\n    width: 100%; \n    max-width: 800px; /* Limits how wide it gets on large desktop screens */\n    aspect-ratio: 16 / 9; /* Forces the horizontal widescreen format automatically */\n    background: #000;\n    border-radius: 20px;\n    overflow: hidden;\n    position: relative;\n    box-shadow: 0 15px 35px rgba(0,0,0,0.15);\n  }\n\n  .video-card-centered video {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    cursor: pointer;\n    display: block;\n  }\n\n  /* Mute Button Overlay */\n  .mute-toggle {\n    position: absolute;\n    top: 20px;\n    right: 20px;\n    background: rgba(0,0,0,0.6);\n    color: white;\n    border: none;\n    padding: 6px 12px;\n    border-radius: 20px;\n    font-size: 11px;\n    font-weight: 700;\n    text-transform: uppercase;\n    cursor: pointer;\n    z-index: 10;\n    transition: opacity 0.3s;\n  }\n\n  /* Text Overlay */\n  .video-overlay {\n    position: absolute;\n    bottom: 30px; /* Slightly lower since horizontal video is shorter */\n    left: 0;\n    right: 0;\n    color: white;\n    text-align: center;\n    font-weight: 800;\n    font-size: 1.4rem;\n    text-transform: uppercase;\n    text-shadow: 0 2px 12px rgba(0,0,0,0.6);\n    pointer-events: none;\n    padding: 0 15px;\n    line-height: 1.1;\n  }\n\n  /* Mobile adjustment */\n  @media (max-width: 480px) {\n    .centered-video-section {\n      padding: 40px 15px;\n    }\n    .video-overlay {\n      font-size: 1.2rem;\n      bottom: 20px;\n    }\n    /* Note: We no longer need to force a height or width here \n       because 'aspect-ratio: 16/9' naturally scales it down perfectly \n       for mobile devices! */\n  }\n</style>",
        "color_scheme": "",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
