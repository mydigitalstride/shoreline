{% liquid
  assign image = block.settings.image
  assign title = block.settings.title
  assign link = block.settings.link
%}

{% if link != blank %}
  <a href="{{ link }}" class="category-cards">
    <div class="category-image" style="background-image:url('{{ image | image_url: width: 900 }}');">
      <div class="category-overlay"></div>
      {% if title != blank %}
        <span class="category-title">{{ title }}</span>
      {% endif %}
    </div>
  </a>
{% else %}
  <div class="category-cards">
    <div class="category-image" style="background-image:url('{{ image | image_url: width: 900 }}');">
      <div class="category-overlay"></div>
      {% if title != blank %}
        <span class="category-title">{{ title }}</span>
      {% endif %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .category-cards {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s ease;
  }

  .category-cards:hover {
    transform: scale(1.02);
  }

  .category-image {
    position: relative;
    background-size: cover;
    background-position: center;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    overflow: hidden;
  }

  .category-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(70, 179, 184, 0.2);
    z-index: 1;
    transition: background 0.4s ease;
  }

  .category-cards:hover .category-overlay {
    background: linear-gradient(to bottom, rgba(70, 179, 184, 0.8), transparent);
  }

  .category-title {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 2;
    color: white;
    font-size: 1.5rem;
    font-weight: bold;
    text-align: left;
    padding: 0;
  }

  /* Mobile adjustments */
  @media (max-width: 600px) {
    .category-image {
      padding: 0.5rem;
    }

    .category-title {
      position: absolute;
      text-align: left;
      left: 0.5rem;
      top: 0.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Boat Gallery",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Category Title"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Boat Gallery",
      "category": "Custom"
    }
  ]
}
{% endschema %}
