{% comment %}
  Renders breadcrumbs with collection context
  Usage:
  {% render 'breadcrumbs' %}
{% endcomment %}

<nav class="breadcrumb" role="navigation" aria-label="breadcrumbs">
  <a href="{{ routes.root_url }}" title="Home">Home</a>

  {% if template == 'product' %}
    {% comment %} Add Shop link {% endcomment %}
    <span aria-hidden="true">&nbsp;›&nbsp;</span>
    <a href="/collections/all" title="Shop">Shop</a>

    {% comment %} Add Collection link if available {% endcomment %}
    {% if collection %}
      <span aria-hidden="true">&nbsp;›&nbsp;</span>
      <a href="{{ collection.url }}" title="{{ collection.title }}">{{ collection.title }}</a>
    {% elsif product.collections.size > 0 %}
      <span aria-hidden="true">&nbsp;›&nbsp;</span>
      <a href="{{ product.collections.first.url }}" title="{{ product.collections.first.title }}">{{ product.collections.first.title }}</a>
    {% endif %}

    {% comment %} Current product {% endcomment %}
    <span aria-hidden="true">&nbsp;›&nbsp;</span>
    <span>{{ product.title }}</span>

  {% elsif template == 'collection' %}
    <span aria-hidden="true">&nbsp;›&nbsp;</span>
    <a href="/collections/all" title="Shop">Shop</a>
    <span aria-hidden="true">&nbsp;›&nbsp;</span>
    <span>{{ collection.title }}</span>

  {% elsif template == 'page' %}
    <span aria-hidden="true">&nbsp;›&nbsp;</span>
    <span>{{ page.title }}</span>

  {% elsif template == 'blog' %}
    <span aria-hidden="true">&nbsp;›&nbsp;</span>
    {% if current_tags %}
      <a href="{{ blog.url }}" title="{{ blog.title }}">{{ blog.title }}</a>
      <span aria-hidden="true">&nbsp;›&nbsp;</span>
      <span>{{ current_tags | join: ", " }}</span>
    {% else %}
      <span>{{ blog.title }}</span>
    {% endif %}

  {% elsif template == 'article' %}
    <span aria-hidden="true">&nbsp;›&nbsp;</span>
    <a href="{{ blog.url }}" title="{{ blog.title }}">{{ blog.title }}</a>
    <span aria-hidden="true">&nbsp;›&nbsp;</span>
    <span>{{ article.title }}</span>

  {% else %}
    <span aria-hidden="true">&nbsp;›&nbsp;</span>
    <span>{{ page_title }}</span>
  {% endif %}
</nav>
